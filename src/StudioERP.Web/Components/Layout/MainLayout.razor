@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider
@inject HttpClient Http
@inject StudioERP.Web.Services.TokenService TokenService

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Json
@using System.Threading

<div class="app-container">
    <header class="topbar">
        <div class="d-flex align-items-center">
            <button class="btn-icon d-md-none me-3" @onclick="ToggleMenu">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-list" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/></svg>
            </button>

            <a href="/" class="brand">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#4f46e5" class="bi bi-camera-video-fill" viewBox="0 0 16 16"><path d="M0 5a2 2 0 0 1 2-2h7.5a2 2 0 0 1 1.983 1.738l3.11-1.382A1 1 0 0 1 16 4.269v7.462a1 1 0 0 1-1.406.913l-3.111-1.382A2 2 0 0 1 9.5 13H2a2 2 0 0 1-2-2V5z"/></svg>
                <span class="ms-2 d-none d-sm-inline">StudioERP</span>
            </a>
        </div>

        <!-- BUSCADOR CONECTADO -->
        <div class="search-bar d-none d-md-block position-relative">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search search-icon" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/></svg>
            <input type="text" placeholder="Buscar clientes, contratos..." @bind="Busqueda" @bind:event="oninput" @onkeyup="Buscar" />
            
            <!-- RESULTADOS DEL BUSCADOR -->
            @if (Resultados != null && (Resultados.Clientes.Any() || Resultados.Contratos.Any()))
            {
                <div class="dropdown-menu show w-100 shadow" style="top: 45px; max-height: 300px; overflow-y: auto; display:block;">
                    @foreach (var c in Resultados.Clientes)
                    {
                        <a class="dropdown-item" href="/ventas/clientes" @onclick="() => LimpiarBusqueda()">
                            <i class="bi bi-person me-2"></i> @c.Nombre <small class="text-muted">(Cliente)</small>
                        </a>
                    }
                    @foreach (var c in Resultados.Contratos)
                    {
                        <a class="dropdown-item" href="/ventas/contratos" @onclick="() => LimpiarBusqueda()">
                            <i class="bi bi-file-earmark-text me-2"></i> @c.Nombre <small class="text-muted">(Contrato)</small>
                        </a>
                    }
                </div>
            }
        </div>

        <div class="user-menu" @onclick="ToggleUserMenu" @onclick:stopPropagation="true">
            <div class="avatar">@InicialUsuario</div>
            <div class="user-info d-none d-sm-flex ms-2">
                <span class="user-name">@NombreUsuario</span>
                <span class="user-role">@RolUsuario</span>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-down ms-2" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.5-.5z"/></svg>
            @if (UserMenuOpen)
            {
                <div class="user-dropdown shadow">
                    <NavLink class="dropdown-item" href="/perfil"><i class="bi bi-person me-2"></i> Mi Perfil</NavLink>
                    <div class="dropdown-divider"></div>
                    <button class="dropdown-item text-danger" @onclick="CerrarSesion"><i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión</button>
                </div>
            }
        </div>
    </header>

    <div class="main-wrapper" @onclick="CerrarMenuSiAbierto">
        <aside class="sidebar @(SidebarOpen ? "open" : "")" @onclick:stopPropagation="true">
            <NavMenu />
        </aside>
        <main class="content">@Body</main>
    </div>
</div>

@code {
    private bool SidebarOpen = false;
    private bool UserMenuOpen = false;
    
    private string NombreUsuario = "Usuario";
    private string RolUsuario = "Rol";
    private string InicialUsuario = "U";

    private string Busqueda = "";
    private ResultadoBusquedaDto? Resultados;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            NombreUsuario = user.Claims.FirstOrDefault(c => c.Type == "nickname")?.Value 
                         ?? user.Claims.FirstOrDefault(c => c.Type == "unique_name")?.Value 
                         ?? user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value 
                         ?? "Usuario";
            
            RolUsuario = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value 
                      ?? "Usuario";
            
            if (!string.IsNullOrEmpty(NombreUsuario))
                InicialUsuario = NombreUsuario.Substring(0, 1).ToUpper();
        }
    }

    private async Task Buscar(KeyboardEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(Busqueda))
        {
            Resultados = null;
            return;
        }

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        try
        {
            await Task.Delay(300, _cts.Token); // Debounce

            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var req = new HttpRequestMessage(HttpMethod.Get, $"api/v1/Search?q={Uri.EscapeDataString(Busqueda)}");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
                Resultados = await res.Content.ReadFromJsonAsync<ResultadoBusquedaDto>();
        }
        catch (TaskCanceledException) { }
    }

    private void LimpiarBusqueda()
    {
        Busqueda = "";
        Resultados = null;
    }

    private void ToggleMenu() 
    {
        SidebarOpen = !SidebarOpen;
        UserMenuOpen = false;
    }
    
    private void ToggleUserMenu() 
    {
        UserMenuOpen = !UserMenuOpen;
        SidebarOpen = false;
    }

    private void CerrarMenuSiAbierto()
    {
        if (SidebarOpen) SidebarOpen = false;
    }

    private async Task CerrarSesion()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
        
        if (AuthProvider is StudioERP.Web.Services.CustomAuthStateProvider customAuth)
        {
            customAuth.NotifyUserLogout();
        }
        
        Nav.NavigateTo("/login", forceLoad: true);
    }

    public class ResultadoBusquedaDto
    {
        public List<ResultadoItemDto> Clientes { get; set; } = new();
        public List<ResultadoItemDto> Contratos { get; set; } = new();
    }

    public class ResultadoItemDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Tipo { get; set; } = "";
    }
}