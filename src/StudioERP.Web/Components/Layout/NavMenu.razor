@code {
    private bool AdminOpen = false;
    private bool VentasOpen = false;
    private bool FinanzasOpen = false;
    private bool EsAdmin = false;
    private bool EsCajero = false;
    private bool EsFotografo = false;
    private bool EsMaquillador = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            EsAdmin = user.IsInRole("Admin");
            EsCajero = user.IsInRole("Cajero");
            EsFotografo = user.IsInRole("Fotógrafo");
            EsMaquillador = user.IsInRole("Maquillador");
        }

        try
        {
            var estadoGuardarFinanzas = await JS.InvokeAsync<string>("localStorage.getItem", "finanzasMenuOpen");
            var estadoGuardadoVentas = await JS.InvokeAsync<string>("localStorage.getItem", "finanzasMenuOpen");

            var estadoGuardadoAdmin = await JS.InvokeAsync<string>("localStorage.getItem", "adminMenuOpen");
            if (!string.IsNullOrEmpty(estadoGuardarFinanzas))
            {
                FinanzasOpen = bool.Parse(estadoGuardarFinanzas);
                AdminOpen = false;
                VentasOpen = false;
            }
            if (!string.IsNullOrEmpty(estadoGuardadoAdmin))
            {
                AdminOpen = bool.Parse(estadoGuardadoAdmin);
                FinanzasOpen = false;
                VentasOpen = false;
            }
            if (!string.IsNullOrEmpty(estadoGuardadoVentas))
            {
                VentasOpen = bool.Parse(estadoGuardadoVentas);
                FinanzasOpen = false;
                AdminOpen = false;
            }
        }
        catch { }
    }

    private async Task ToggleAdmin()
    {
        AdminOpen = !AdminOpen;
        VentasOpen = false;
        FinanzasOpen = false;
        await JS.InvokeVoidAsync("localStorage.setItem", "adminMenuOpen", AdminOpen.ToString().ToLower());
    }
    private async Task ToggleFinanzas()
    {
        FinanzasOpen = !FinanzasOpen;
        AdminOpen = false;
        VentasOpen = false;
        await JS.InvokeVoidAsync("localStorage.setItem", "finanzasMenuOpen", FinanzasOpen.ToString().ToLower());
    }
    private async Task ToggleVentas()
    {
        FinanzasOpen = false;
        AdminOpen = false;
        VentasOpen = !VentasOpen;
        await JS.InvokeVoidAsync("localStorage.setItem", "ventasMenuOpen", VentasOpen.ToString().ToLower());
    }
    private async Task ToggleChangemenu()
    {
        /* FinanzasOpen = false;
         AdminOpen=false;*/
    }

}