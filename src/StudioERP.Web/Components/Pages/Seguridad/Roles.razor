@page "/roles"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Net.Http.Json
@using Microsoft.JSInterop
@using StudioERP.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService
<PageTitle>Roles y Permisos - StudioERP</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0">Roles y Permisos</h4>
    <button class="btn btn-primary" @onclick="AbrirFormularioNuevo">
        <i class="bi bi-plus-lg"></i> Nuevo Rol
    </button>
</div>

@if (MensajeError != "") { <div class="alert alert-danger">@MensajeError</div> }
@if (MensajeExito != "") { <div class="alert alert-success">@MensajeExito</div> }

<!-- Formulario de Creación -->
@if (MostrarFormulario)
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <h6 class="fw-bold mb-3">@(RolEditandoId.HasValue ? "Editar Rol" : "Crear Nuevo Rol")</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Nombre del Rol</label>
                    <input class="form-control" @bind="FormularioRol.Nombre" placeholder="Ej. Fotógrafo" />
                </div>
                <div class="col-md-8">
                    <label class="form-label small fw-bold">Descripción</label>
                    <input class="form-control" @bind="FormularioRol.Descripcion" placeholder="Ej. Encargado de tomar fotos" />
                </div>
            </div>

            <h6 class="fw-bold mb-3 border-bottom pb-2">Permisos del Sistema</h6>
            <div class="row g-4">
                @foreach (var modulo in Modulos)
                {
                    <div class="col-md-4">
                        <div class="card h-100 border">
                            <div class="card-header bg-light fw-bold">@modulo.Nombre</div>
                            <div class="card-body">
                                @foreach (var permiso in modulo.Permisos)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" 
                                               id="@permiso" 
                                               checked="@FormularioRol.Permisos.Contains(permiso)"
                                               @onchange="e => TogglePermiso(permiso, (bool)e.Value)" />
                                        <label class="form-check-label" for="@permiso">@permiso.Split('.')[1]</label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-4">
                <button class="btn btn-success" @onclick="GuardarRol">@(RolEditandoId.HasValue ? "Guardar Cambios" : "Guardar Rol")</button>
                @if (RolEditandoId.HasValue)
                {
                    <button class="btn btn-outline-secondary ms-2" @onclick="CancelarEdicion">Cancelar</button>
                }
            </div>
        </div>
    </div>
}

<!-- Tabla de Roles -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Rol</th>
                    <th>Descripción</th>
                    <th>Permisos</th>
                    <th>Usuarios</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (ListaRoles == null)
                {
                    <tr><td colspan="5" class="text-center py-4 text-muted">Cargando...</td></tr>
                }
                else
                {
                    @foreach (var r in ListaRoles)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@r.Nombre</td>
                            <td class="text-muted">@r.Descripcion</td>
                            <td>
                                <div style="max-width: 400px; white-space: normal;">
                                    @if (!string.IsNullOrEmpty(r.Permisos))
                                    {
                                        @foreach (var p in r.Permisos.Split(','))
                                        {
                                            <span class="badge bg-info text-dark me-1 mb-1" style="font-size: 0.75rem;">@p</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin permisos</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-secondary rounded-pill">@r.CantidadUsuarios</span>
                                @if (r.Usuarios.Count > 0)
                                {
                                    <div class="small text-muted mt-1">
                                        @foreach (var usuario in r.Usuarios)
                                        {
                                            <div>@usuario.NombreCompleto (@@@usuario.Username)</div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="small text-muted">Sin usuarios activos</div>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => EditarRol(r)">
                                        <i class="bi bi-pencil"></i> Editar
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarRol(r)">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<RolDto>? ListaRoles;
    private bool MostrarFormulario = false;
    private string MensajeError = "";
    private string MensajeExito = "";
    
    private NuevoRolDto FormularioRol = new() { Permisos = new List<string>() };
    private Guid? RolEditandoId;

    // Lista de módulos y permisos disponibles para la interfaz
    private List<ModuloPermisos> Modulos = new()
    {
        new ModuloPermisos { Nombre = "Agenda", Permisos = new() { "Agenda.Ver", "Agenda.Editar" } },
        new ModuloPermisos { Nombre = "Clientes", Permisos = new() { "Clientes.Ver", "Clientes.Crear", "Clientes.Editar", "Clientes.Eliminar" } },
        new ModuloPermisos { Nombre = "Contratos", Permisos = new() { "Contratos.Ver", "Contratos.Crear", "Contratos.Editar", "Contratos.Cancelar" } },
        new ModuloPermisos { Nombre = "Catálogo", Permisos = new() { "Catalogos.Ver", "Catalogos.Crear", "Catalogos.Editar" } },
        new ModuloPermisos { Nombre = "Finanzas", Permisos = new() { "Finanzas.Ver", "Finanzas.RegistrarPago", "Finanzas.VerificarPago", "Finanzas.VerComisiones" } },
        new ModuloPermisos { Nombre = "Administración", Permisos = new() { "Usuarios.Ver", "Usuarios.Crear", "Usuarios.Editar", "Usuarios.Eliminar", "Roles.Ver", "Roles.Crear", "Roles.Editar", "Staff.Ver", "Staff.Crear", "Staff.Editar", "Proveedores.Ver", "Proveedores.Crear", "Proveedores.Editar" } }
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarRoles();
    }

    private void AbrirFormularioNuevo()
    {
        RolEditandoId = null;
        FormularioRol = new() { Permisos = new List<string>() };
        MostrarFormulario = !MostrarFormulario;
    }

    private async Task CargarRoles()
    {
        if (string.IsNullOrEmpty(TokenService.Token))
            TokenService.Token = await JS.InvokeAsync<string>("leerToken");

        var req = new HttpRequestMessage(HttpMethod.Get, "api/v1/Roles");
        req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        var res = await Http.SendAsync(req);
        
        if (res.IsSuccessStatusCode)
            ListaRoles = await res.Content.ReadFromJsonAsync<List<RolDto>>();
        else if (res.StatusCode == System.Net.HttpStatusCode.Forbidden)
            MensajeError = "No tienes permisos para ver esta página. Debes ser Administrador.";
    }

    private void TogglePermiso(string permiso, bool seleccionado)
    {
        if (seleccionado)
        {
            if (!FormularioRol.Permisos.Contains(permiso)) FormularioRol.Permisos.Add(permiso);
        }
        else
        {
            FormularioRol.Permisos.Remove(permiso);
        }
    }

    private async Task GuardarRol()
    {
        MensajeError = ""; MensajeExito = "";
        if (string.IsNullOrWhiteSpace(FormularioRol.Nombre))
        {
            MensajeError = "El nombre del rol es obligatorio.";
            return;
        }

        if (string.IsNullOrEmpty(TokenService.Token))
            TokenService.Token = await JS.InvokeAsync<string>("leerToken");

        // Convertimos la lista de permisos a un string separado por comas
        var request = new 
        { 
            Nombre = FormularioRol.Nombre.Trim(),
            Descripcion = FormularioRol.Descripcion.Trim(),
            Permisos = string.Join(",", FormularioRol.Permisos)
        };

        var method = RolEditandoId.HasValue ? HttpMethod.Put : HttpMethod.Post;
        var url = RolEditandoId.HasValue ? $"api/v1/Roles/{RolEditandoId}" : "api/v1/Roles";
        var req = new HttpRequestMessage(method, url);
        req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        req.Content = JsonContent.Create(request);
        
        var res = await Http.SendAsync(req);

        if (res.IsSuccessStatusCode)
        {
            MensajeExito = RolEditandoId.HasValue ? "Rol actualizado correctamente." : "Rol creado correctamente.";
            MostrarFormulario = false;
            FormularioRol = new() { Permisos = new List<string>() };
            RolEditandoId = null;
            await CargarRoles();
        }
        else
        {
            var error = await res.Content.ReadAsStringAsync();
            MensajeError = string.IsNullOrEmpty(error) ? "Error al guardar el rol." : error.Replace("\"", "");
        }
    }

    private void EditarRol(RolDto rol)
    {
        RolEditandoId = rol.Id;
        FormularioRol = new()
        {
            Nombre = rol.Nombre,
            Descripcion = rol.Descripcion,
            Permisos = string.IsNullOrWhiteSpace(rol.Permisos)
                ? new List<string>()
                : rol.Permisos.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList()
        };
        MostrarFormulario = true;
        MensajeError = "";
    }

    private void CancelarEdicion()
    {
        RolEditandoId = null;
        FormularioRol = new() { Permisos = new List<string>() };
        MostrarFormulario = false;
    }

    private async Task EliminarRol(RolDto rol)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el rol {rol.Nombre}?"))
            return;

        MensajeError = "";
        var req = new HttpRequestMessage(HttpMethod.Delete, $"api/v1/Roles/{rol.Id}");
        req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        var res = await Http.SendAsync(req);
        if (res.IsSuccessStatusCode)
        {
            MensajeExito = "Rol eliminado correctamente.";
            await CargarRoles();
        }
        else
        {
            var error = await res.Content.ReadAsStringAsync();
            MensajeError = string.IsNullOrWhiteSpace(error) ? "No se pudo eliminar el rol." : error.Replace("\"", "");
        }
    }

    // --- CLASES DTO ---
    public class RolDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public string Permisos { get; set; } = "";
        public int CantidadUsuarios { get; set; }
        public List<UsuarioRolDto> Usuarios { get; set; } = new();
    }

    public class UsuarioRolDto
    {
        public Guid Id { get; set; }
        public string Username { get; set; } = "";
        public string NombreCompleto { get; set; } = "";
    }

    public class NuevoRolDto
    {
        public string Nombre { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public List<string> Permisos { get; set; } = new();
    }

    public class ModuloPermisos
    {
        public string Nombre { get; set; } = "";
        public List<string> Permisos { get; set; } = new();
    }
}