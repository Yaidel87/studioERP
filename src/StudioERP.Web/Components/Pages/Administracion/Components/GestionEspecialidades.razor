@using System.Net.Http.Json
@using StudioERP.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService

<div class="card shadow-sm border-0">
    <!-- CABECERA: Título y formulario rápido para crear -->
    <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold m-0"><i class="bi bi-tags me-2"></i>Listado de Especialidades</h6>
        <div class="d-flex gap-2">
            <input type="text" class="form-control form-control-sm" placeholder="Nueva especialidad..." @bind="NuevoTipoNombre" style="width: 200px;" />
            <button class="btn btn-sm btn-primary" @onclick="CrearTipo">Añadir</button>
        </div>
    </div>
    
    <!-- MENSAJES DE ALERTA -->
    @if (!string.IsNullOrEmpty(MensajeError))
    {
        <div class="alert alert-danger m-3 py-2">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @MensajeError
        </div>
    }

    <!-- CUERPO: Tabla de especialidades -->
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Nombre</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (ListaTipos == null)
                {
                    <tr><td colspan="2" class="text-center py-4 text-muted">Cargando...</td></tr>
                }
                else if (!ListaTipos.Any())
                {
                    <tr><td colspan="2" class="text-center py-4 text-muted">No hay especialidades creadas.</td></tr>
                }
                else
                {
                    @foreach (var t in ListaTipos)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@t.Nombre</td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarTipo(t.Id)" title="Eliminar">
                                    <i class="bi bi-trash"></i> Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<TipoStaffDto>? ListaTipos;
    private string NuevoTipoNombre = "";
    private string MensajeError = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarTipos();
    }

    private async Task CargarTipos()
    {
        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var req = new HttpRequestMessage(HttpMethod.Get, "api/v1/Staff/tipos");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var res = await Http.SendAsync(req);
            
            if (res.IsSuccessStatusCode)
                ListaTipos = await res.Content.ReadFromJsonAsync<List<TipoStaffDto>>() ?? new();
        }
        catch { }
    }

    private async Task CrearTipo()
    {
        if (string.IsNullOrEmpty(NuevoTipoNombre)) return;
        
        MensajeError = "";
        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var request = new { Nombre = NuevoTipoNombre };
            var req = new HttpRequestMessage(HttpMethod.Post, "api/v1/Staff/tipos");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            req.Content = JsonContent.Create(request);
            
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
            {
                NuevoTipoNombre = "";
                await CargarTipos();
            }
            else
            {
                var errorContent = await res.Content.ReadAsStringAsync();
                MensajeError = $"Error HTTP {(int)res.StatusCode}: {(string.IsNullOrEmpty(errorContent) ? "Sin detalles." : errorContent.Replace("\"", ""))}";
            }
        }
        catch { }
    }

    private async Task EliminarTipo(Guid id)
    {
        bool confirmar = await JS.InvokeAsync<bool>("confirm", "¿Seguro que deseas eliminar esta especialidad?");
        if (!confirmar) return;

        MensajeError = ""; 

        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var req = new HttpRequestMessage(HttpMethod.Delete, $"api/v1/Staff/tipos/{id}");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
            {
                await CargarTipos();
            }
            else
            {
                // Esto nos mostrará el código de error (ej. 400) y el mensaje del backend
                var errorContent = await res.Content.ReadAsStringAsync();
                MensajeError = $"Error HTTP {(int)res.StatusCode}: {errorContent.Replace("\"", "")}";
            }
        }
        catch (Exception ex)
        {
            MensajeError = "Error de conexión: " + ex.Message;
        }
    }

    public class TipoStaffDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
    }
}