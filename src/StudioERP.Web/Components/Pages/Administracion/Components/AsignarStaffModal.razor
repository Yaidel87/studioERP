@using System.Net.Http.Json
@using StudioERP.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService

@if (Mostrar)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Asignar Personal a la Sesión</h5>
                    <button type="button" class="btn-close" @onclick="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(ErrorMensaje))
                    {
                        <div class="alert alert-danger">@ErrorMensaje</div>
                    }

                    <!-- PASO 1: SELECCIONAR ESPECIALIDAD Y TRABAJADOR -->
                    <div class="row g-2 mb-4 align-items-end bg-light p-3 rounded">
                        
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">1. Especialidad Requerida</label>
                            <select class="form-select" @bind="EspecialidadSeleccionada" @bind:after="FiltrarTrabajadores">
                                <option value="">Seleccione...</option>
                                @foreach (var esp in ListaEspecialidades)
                                {
                                    <option value="@esp">@esp</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold">2. Trabajador</label>
                            <select class="form-select" @bind="StaffSeleccionadoId" disabled="@(string.IsNullOrEmpty(EspecialidadSeleccionada))">
                                <option value="@Guid.Empty">Seleccione...</option>
                                @foreach (var s in TrabajadoresFiltrados)
                                {
                                    <option value="@s.Id">@s.NombreCompleto</option>
                                }
                            </select>
                        </div>
                        
                        <div class="col-md-2">
                            <label class="form-label small fw-bold">Comisión (USD)</label>
                            <input type="number" class="form-control" @bind="ComisionTemporal" />
                        </div>
                        
                        <div class="col-md-2">
                            <button class="btn btn-outline-primary w-100" @onclick="AgregarALista">+ Agregar</button>
                        </div>
                    </div>

                    <!-- LISTA DE PERSONAL A ASIGNAR -->
                    <h6 class="fw-bold border-bottom pb-2">Equipo Asignado a esta Sesión</h6>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Rol</th>
                                <th>Nombre</th>
                                <th>Comisión (USD)</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!StaffTemporal.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">No ha agregado personal aún.</td></tr>
                            }
                            else
                            {
                                @foreach (var item in StaffTemporal)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">@item.Especialidad</span></td>
                                        <td class="fw-bold">@item.NombreCompleto</td>
                                        <td>$@item.Comision</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => QuitarDeLista(item)">X</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="GuardarTodo" disabled="@Guardando">
                        @if (Guardando) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Guardar Asignaciones
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Mostrar { get; set; } = false;
    [Parameter] public EventCallback<bool> MostrarChanged { get; set; }
    [Parameter] public EventCallback OnGuardado { get; set; }
    [Parameter] public Guid SesionId { get; set; }

    private List<StaffDto> ListaStaff = new();
    private List<AsignacionTemporalDto> StaffTemporal = new();
    
    private List<string> ListaEspecialidades = new();
    private List<StaffDto> TrabajadoresFiltrados = new();

    private string EspecialidadSeleccionada = "";
    private Guid StaffSeleccionadoId;
    private decimal ComisionTemporal;

    private bool Guardando = false;
    private string ErrorMensaje = "";

    protected override async Task OnParametersSetAsync()
    {
        if (Mostrar)
        {
            StaffTemporal.Clear();
            EspecialidadSeleccionada = "";
            StaffSeleccionadoId = Guid.Empty;
            ComisionTemporal = 0;
            ErrorMensaje = "";
            await CargarStaff();
        }
    }

    private async Task CargarStaff()
    {
        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var req = new HttpRequestMessage(HttpMethod.Get, "api/v1/Personal");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var res = await Http.SendAsync(req);
            
            if (res.IsSuccessStatusCode)
            {
                ListaStaff = await res.Content.ReadFromJsonAsync<List<StaffDto>>() ?? new();
                
                ListaEspecialidades = ListaStaff
                    .SelectMany(s => s.Especialidades)
                    .Distinct()
                    .OrderBy(e => e)
                    .ToList();
            }
        }
        catch { }
    }

    private void FiltrarTrabajadores()
    {
        StaffSeleccionadoId = Guid.Empty;
        if (string.IsNullOrEmpty(EspecialidadSeleccionada))
        {
            TrabajadoresFiltrados = new();
        }
        else
        {
            TrabajadoresFiltrados = ListaStaff
                .Where(s => s.Especialidades.Contains(EspecialidadSeleccionada))
                .ToList();
        }
    }

    private void AgregarALista()
    {
        ErrorMensaje = "";
        if (StaffSeleccionadoId == Guid.Empty || string.IsNullOrEmpty(EspecialidadSeleccionada))
        {
            ErrorMensaje = "Debe seleccionar una especialidad y un trabajador.";
            return;
        }

        if (StaffTemporal.Any(s => s.StaffId == StaffSeleccionadoId))
        {
            ErrorMensaje = "Este trabajador ya está en la lista para esta sesión.";
            return;
        }

        var staff = ListaStaff.FirstOrDefault(s => s.Id == StaffSeleccionadoId);
        if (staff == null) return;

        StaffTemporal.Add(new AsignacionTemporalDto
        {
            StaffId = staff.Id,
            NombreCompleto = staff.NombreCompleto,
            Especialidad = EspecialidadSeleccionada,
            Comision = ComisionTemporal
        });

        EspecialidadSeleccionada = "";
        StaffSeleccionadoId = Guid.Empty;
        ComisionTemporal = 0;
        TrabajadoresFiltrados.Clear();
    }

    private void QuitarDeLista(AsignacionTemporalDto item)
    {
        StaffTemporal.Remove(item);
    }

    private async Task GuardarTodo()
    {
        ErrorMensaje = "";
        if (!StaffTemporal.Any())
        {
            ErrorMensaje = "Debe agregar al menos un miembro del staff.";
            return;
        }

        Guardando = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            foreach (var item in StaffTemporal)
            {
                var request = new { SesionId = SesionId, StaffId = item.StaffId, ComisionPactadaUSD = item.Comision };
                var req = new HttpRequestMessage(HttpMethod.Post, "api/v1/Agenda/sesiones/asignar");
                req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
                req.Content = JsonContent.Create(request);
                var res = await Http.SendAsync(req);

                if (!res.IsSuccessStatusCode)
                {
                    var error = await res.Content.ReadAsStringAsync();
                    ErrorMensaje = $"Error al asignar a {item.NombreCompleto}: {error.Replace("\"", "")}";
                    return;
                }
            }

            await OnGuardado.InvokeAsync();
            await Cerrar();
        }
        catch (Exception ex)
        {
            ErrorMensaje = "Error: " + ex.Message;
        }
        finally
        {
            Guardando = false;
            StateHasChanged();
        }
    }

    private async Task Cerrar()
    {
        await MostrarChanged.InvokeAsync(false);
    }

    public class StaffDto
    {
        public Guid Id { get; set; }
        public string NombreUsuario { get; set; } = "";
        public List<string> Especialidades { get; set; } = new();
        public string NombreCompleto => NombreUsuario;
    }

    public class AsignacionTemporalDto
    {
        public Guid StaffId { get; set; }
        public string NombreCompleto { get; set; } = "";
        public string Especialidad { get; set; } = "";
        public decimal Comision { get; set; }
    }
}