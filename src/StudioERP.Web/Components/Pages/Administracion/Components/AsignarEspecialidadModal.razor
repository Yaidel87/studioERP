@using System.Net.Http.Json
@using StudioERP.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService

@if (Mostrar)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Asignar Especialidad</h5>
                    <button type="button" class="btn-close" @onclick="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(ErrorMensaje))
                    {
                        <div class="alert alert-danger">@ErrorMensaje</div>
                    }

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Usuario</label>
                            <select class="form-select" @bind="UsuarioId" disabled="@UsuarioIdFijo.HasValue">
                                <option value="@Guid.Empty">Seleccione un usuario...</option>
                                @foreach (var u in ListaUsuarios)
                                {
                                    <option value="@u.Id">@u.NombreCompleto (@@@u.Username)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Especialidad</label>
                            <select class="form-select" @bind="TipoStaffId">
                                <option value="@Guid.Empty">Seleccione tipo...</option>
                                @foreach (var t in ListaTipos)
                                {
                                    <option value="@t.Id">@t.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="Guardar" disabled="@Guardando">
                        @if (Guardando) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Asignar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Mostrar { get; set; } = false;
    [Parameter] public EventCallback<bool> MostrarChanged { get; set; }
    [Parameter] public EventCallback OnGuardado { get; set; }
    
    // Si se pasa este ID, el usuario ya viene seleccionado (útil al crear un usuario nuevo)
    [Parameter] public Guid? UsuarioIdFijo { get; set; }

    private List<UsuarioDto> ListaUsuarios = new();
    private List<TipoStaffDto> ListaTipos = new();
    private Guid UsuarioId;
    private Guid TipoStaffId;
    private bool Guardando = false;
    private string ErrorMensaje = "";

    protected override async Task OnParametersSetAsync()
    {
        if (Mostrar)
        {
            if (UsuarioIdFijo.HasValue)
            {
                UsuarioId = UsuarioIdFijo.Value;
            }
            await CargarDatos();
        }
    }

    private async Task CargarDatos()
    {
        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            // Cargar Usuarios
            var reqUsers = new HttpRequestMessage(HttpMethod.Get, "api/v1/Usuarios");
            reqUsers.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var resUsers = await Http.SendAsync(reqUsers);
            if (resUsers.IsSuccessStatusCode)
                ListaUsuarios = await resUsers.Content.ReadFromJsonAsync<List<UsuarioDto>>() ?? new();

            // Cargar Tipos de Staff
            var reqTipos = new HttpRequestMessage(HttpMethod.Get, "api/v1/Staff/tipos");
            reqTipos.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var resTipos = await Http.SendAsync(reqTipos);
            if (resTipos.IsSuccessStatusCode)
                ListaTipos = await resTipos.Content.ReadFromJsonAsync<List<TipoStaffDto>>() ?? new();
        }
        catch { }
    }

    private async Task Guardar()
    {
        ErrorMensaje = "";
        if (UsuarioId == Guid.Empty || TipoStaffId == Guid.Empty)
        {
            ErrorMensaje = "Debe seleccionar un usuario y una especialidad.";
            return;
        }

        Guardando = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var request = new { UsuarioId = UsuarioId, TipoStaffId = TipoStaffId };
            var req = new HttpRequestMessage(HttpMethod.Post, "api/v1/Staff");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            req.Content = JsonContent.Create(request);
            
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
            {
                await OnGuardado.InvokeAsync();
                await Cerrar();
            }
            else
            {
                var error = await res.Content.ReadAsStringAsync();
                ErrorMensaje = string.IsNullOrEmpty(error) ? "Error al asignar especialidad." : error.Replace("\"", "");
            }
        }
        catch (Exception ex)
        {
            ErrorMensaje = "Error: " + ex.Message;
        }
        finally
        {
            Guardando = false;
            StateHasChanged();
        }
    }

    private async Task Cerrar()
    {
        UsuarioId = Guid.Empty;
        TipoStaffId = Guid.Empty;
        ErrorMensaje = "";
        await MostrarChanged.InvokeAsync(false);
    }

    // --- CLASES DTO ---
    public class UsuarioDto
    {
        public Guid Id { get; set; }
        public string Username { get; set; } = "";
        public string NombreCompleto { get; set; } = "";
    }

    public class TipoStaffDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
    }
}