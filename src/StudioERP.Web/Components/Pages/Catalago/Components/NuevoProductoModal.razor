@using System.Net.Http.Json
@using StudioERP.Web.Services
@using System.Text.Json

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService

@if (Mostrar)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Nuevo Producto</h5>
                    <button type="button" class="btn-close" @onclick="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(ErrorMensaje)) { <div class="alert alert-danger">@ErrorMensaje</div> }

                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Nombre del Producto</label>
                            <input class="form-control" @bind="Producto.Nombre" placeholder="Ej. Álbum 8x10" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Precio Venta (USD)</label>
                            <!-- AÑADIDO: @bind:after para recalcular -->
                            <input type="number" class="form-control" @bind="Producto.PrecioVentaBaseUSD" @bind:after="CalcularTotales" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold">Categoría (Define los campos de costo)</label>
                        <select class="form-select" @bind="CategoriaSeleccionadaId" @bind:after="OnCategoriaSeleccionada">
                            <option value="@Guid.Empty">Seleccione una categoría...</option>
                            @foreach (var c in ListaCategorias)
                            {
                                <option value="@c.Id">@c.Nombre</option>
                            }
                        </select>
                    </div>

                    <!-- FICHA DE COSTO DINÁMICA -->
                    @if (CategoriaNombre == "Fotos Sueltas")
                    {
                        <h6 class="fw-bold border-bottom pb-2 mb-3">Ficha de Costo: Fotos Sueltas</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Formato (ej. 8x10)</label>
                                <input class="form-control" @bind="Costo.Formato" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Costo Impresión (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.CostoImpresion" @bind:after="CalcularTotales" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Costo Edición (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.CostoEdicion" @bind:after="CalcularTotales" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Otros Gastos (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.OtrosGastos" @bind:after="CalcularTotales" />
                            </div>
                        </div>
                    }
                    else if (CategoriaNombre == "Enmarcados")
                    {
                        <h6 class="fw-bold border-bottom pb-2 mb-3">Ficha de Costo: Enmarcados</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Formato (ej. 16x20)</label>
                                <input class="form-control" @bind="Costo.Formato" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Costo Enmarcado (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.CostoEnmarcado" @bind:after="CalcularTotales" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Costo Edición (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.CostoEdicion" @bind:after="CalcularTotales" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Otros Gastos (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.OtrosGastos" @bind:after="CalcularTotales" />
                            </div>
                        </div>
                    }
                    else if (CategoriaNombre == "Álbumes")
                    {
                        <h6 class="fw-bold border-bottom pb-2 mb-3">Ficha de Costo: Álbumes</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Formato (ej. 8x10)</label>
                                <input class="form-control" @bind="Costo.Formato" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Costo Confección (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.CostoConfeccion" @bind:after="CalcularTotales" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Costo Esquinero (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.CostoEsquinero" @bind:after="CalcularTotales" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Costo Diseño (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.CostoDiseno" @bind:after="CalcularTotales" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Otros Gastos (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.OtrosGastos" @bind:after="CalcularTotales" />
                            </div>
                        </div>
                    }
                    else if (CategoriaNombre == "Photobooks")
                    {
                        <h6 class="fw-bold border-bottom pb-2 mb-3">Ficha de Costo: Photobooks</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Formato (ej. 8x12)</label>
                                <input class="form-control" @bind="Costo.Formato" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Costo Portada (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.CostoPortada" @bind:after="CalcularTotales" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Costo Pliego (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.CostoPliego" @bind:after="CalcularTotales" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Cant. de Pliegos</label>
                                <input type="number" class="form-control" @bind="Costo.CantidadPliegos" @bind:after="CalcularTotales" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Costo Montaje (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.CostoMontaje" @bind:after="CalcularTotales" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Costo Diseño (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.CostoDiseno" @bind:after="CalcularTotales" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Costo Edición (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.CostoEdicion" @bind:after="CalcularTotales" />
                            </div>
                        </div>
                    }
                    else if (CategoriaNombre == "Extras")
                    {
                        <h6 class="fw-bold border-bottom pb-2 mb-3">Ficha de Costo: Extras (Llaveros, Afiches, etc.)</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Costo Base (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.CostoBase" @bind:after="CalcularTotales" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Costo Diseño (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.CostoDiseno" @bind:after="CalcularTotales" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Otros Gastos (USD)</label>
                                <input type="number" class="form-control" @bind="Costo.OtrosGastos" @bind:after="CalcularTotales" />
                            </div>
                        </div>
                    }

                    <!-- RESUMEN DE COSTOS Y RENTABILIDAD -->
                    @if (CategoriaSeleccionadaId != Guid.Empty)
                    {
                        <div class="card bg-light mt-4 border-0">
                            <div class="card-body p-3">
                                <div class="row text-center">
                                    <div class="col-md-4">
                                        <small class="text-muted d-block">Costo Total (USD)</small>
                                        <h5 class="fw-bold text-danger mb-0">$@CostoTotalCalculado</h5>
                                    </div>
                                    <div class="col-md-4 border-start border-end">
                                        <small class="text-muted d-block">Precio Venta (USD)</small>
                                        <h5 class="fw-bold text-success mb-0">$@Producto.PrecioVentaBaseUSD</h5>
                                    </div>
                                    <div class="col-md-4">
                                        <small class="text-muted d-block">Ganancia Bruta (USD)</small>
                                        <h5 class="fw-bold @(GananciaBruta >= 0 ? "text-primary" : "text-danger") mb-0">
                                            $@GananciaBruta
                                        </h5>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                    <button class="btn btn-primary" @onclick="Guardar" disabled="@Guardando">
                        @if (Guardando) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Guardar Producto
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Mostrar { get; set; } = false;
    [Parameter] public EventCallback<bool> MostrarChanged { get; set; }
    [Parameter] public EventCallback OnGuardado { get; set; }

    private List<CategoriaDto> ListaCategorias = new();
    private ProductoDto Producto = new();
    private CostoDetalleDto Costo = new();
    
    private Guid CategoriaSeleccionadaId = Guid.Empty;
    private string CategoriaNombre = "";
    
    private bool Guardando = false;
    private string ErrorMensaje = "";

    private decimal CostoTotalCalculado = 0;
    private decimal GananciaBruta = 0;

    protected override async Task OnParametersSetAsync()
    {
        if (Mostrar)
        {
            Producto = new();
            Costo = new();
            CategoriaSeleccionadaId = Guid.Empty;
            CategoriaNombre = "";
            ErrorMensaje = "";
            CostoTotalCalculado = 0;
            GananciaBruta = 0;
            await CargarCategorias();
        }
    }

    private async Task CargarCategorias()
    {
        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var req = new HttpRequestMessage(HttpMethod.Get, "api/v1/Catalogos/categorias");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var res = await Http.SendAsync(req);
            if (res.IsSuccessStatusCode)
                ListaCategorias = await res.Content.ReadFromJsonAsync<List<CategoriaDto>>() ?? new();
        }
        catch { }
    }

    private void OnCategoriaSeleccionada()
    {
        var cat = ListaCategorias.FirstOrDefault(c => c.Id == CategoriaSeleccionadaId);
        CategoriaNombre = cat?.Nombre ?? "";
        Costo = new();
        CalcularTotales();
    }

    // --- CÁLCULO DE COSTOS Y GANANCIA ---
    private void CalcularTotales()
    {
        // Sumamos todos los campos de costo posibles
        CostoTotalCalculado = Costo.CostoImpresion + Costo.CostoEdicion + Costo.OtrosGastos + 
                              Costo.CostoEnmarcado + Costo.CostoConfeccion + Costo.CostoEsquinero + 
                              Costo.CostoDiseno + Costo.CostoPortada + Costo.CostoPliego + 
                              Costo.CostoMontaje + Costo.CostoBase;

        // Si es Photobook, sumamos el costo de los pliegos
        if (CategoriaNombre == "Photobooks")
        {
            CostoTotalCalculado += (Costo.CostoPliego * Costo.CantidadPliegos);
        }

        GananciaBruta = Producto.PrecioVentaBaseUSD - CostoTotalCalculado;
    }

    private async Task Guardar()
    {
        ErrorMensaje = "";
        if (string.IsNullOrEmpty(Producto.Nombre) || CategoriaSeleccionadaId == Guid.Empty)
        {
            ErrorMensaje = "El nombre y la categoría son obligatorios.";
            return;
        }

        Guardando = true;
        StateHasChanged();

        try
        {
            var detalleCostoJson = JsonSerializer.Serialize(Costo);

            var request = new 
            { 
                Nombre = Producto.Nombre, 
                PrecioVentaBaseUSD = Producto.PrecioVentaBaseUSD, 
                CategoriaProductoId = CategoriaSeleccionadaId, 
                DetalleCosto = detalleCostoJson 
            };

            var req = new HttpRequestMessage(HttpMethod.Post, "api/v1/Catalogos/productos");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            req.Content = JsonContent.Create(request);
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
            {
                await OnGuardado.InvokeAsync();
                await Cerrar();
            }
            else
            {
                var error = await res.Content.ReadAsStringAsync();
                ErrorMensaje = string.IsNullOrEmpty(error) ? "Error al crear producto." : error.Replace("\"", "");
            }
        }
        catch (Exception ex) { ErrorMensaje = "Error: " + ex.Message; }
        finally { Guardando = false; StateHasChanged(); }
    }

    private async Task Cerrar() => await MostrarChanged.InvokeAsync(false);

    // DTOs
    public class CategoriaDto { public Guid Id { get; set; } public string Nombre { get; set; } = ""; }
    public class ProductoDto { public string Nombre { get; set; } = ""; public decimal PrecioVentaBaseUSD { get; set; } }

    public class CostoDetalleDto
    {
        public string Formato { get; set; } = "";
        public decimal OtrosGastos { get; set; }
        public decimal CostoImpresion { get; set; }
        public decimal CostoEdicion { get; set; }
        public decimal CostoEnmarcado { get; set; }
        public decimal CostoConfeccion { get; set; }
        public decimal CostoEsquinero { get; set; }
        public decimal CostoDiseno { get; set; }
        public decimal CostoPortada { get; set; }
        public decimal CostoPliego { get; set; }
        public int CantidadPliegos { get; set; }
        public decimal CostoMontaje { get; set; }
        public decimal CostoBase { get; set; }
    }
}