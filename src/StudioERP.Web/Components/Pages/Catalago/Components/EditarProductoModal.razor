@using System.Net.Http.Json
@using StudioERP.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService

@if (Mostrar)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Producto</h5>
                    <button type="button" class="btn-close" @onclick="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(ErrorMensaje))
                    {
                        <div class="alert alert-danger">@ErrorMensaje</div>
                    }
                    @if (Producto == null)
                    {
                        <p class="text-center"><span class="spinner-border spinner-border-sm me-2"></span>Cargando...</p>
                    }
                    else
                    {
                        @if (!ModoEdicion)
                        {
                            <div class="alert alert-info d-flex justify-content-between align-items-center">
                                <span>Modo de solo lectura</span>
                                <button class="btn btn-sm btn-primary" @onclick="() => ModoEdicion = true">Habilitar edición</button>
                            </div>
                        }
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="form-label">Nombre del producto</label>
                                <input class="form-control" @bind="Producto.Nombre" disabled="@(!ModoEdicion)" maxlength="200" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Precio base de venta (USD)</label>
                                <input type="number" class="form-control" min="0" step="0.01" @bind="Producto.PrecioVentaBaseUSD" disabled="@(!ModoEdicion)" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Categoría</label>
                                <select class="form-select" @bind="Producto.CategoriaProductoId" disabled="@(!ModoEdicion)">
                                    <option value="">Sin categoría</option>
                                    @foreach (var categoria in Categorias)
                                    {
                                        <option value="@categoria.Id">@categoria.Nombre</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="alert alert-info mt-3 mb-0">
                            Los costos y precios por formato/contexto se administran en <strong>Fichas de costo</strong>.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Cerrar">Cerrar</button>
                    @if (ModoEdicion && Producto != null)
                    {
                        <button class="btn btn-primary" @onclick="Guardar" disabled="@Guardando">
                            @(Guardando ? "Guardando..." : "Guardar cambios")
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Mostrar { get; set; }
    [Parameter] public EventCallback<bool> MostrarChanged { get; set; }
    [Parameter] public EventCallback OnGuardado { get; set; }
    [Parameter] public Guid ProductoId { get; set; }

    private ProductoDto? Producto;
    private List<CategoriaDto> Categorias = new();
    private bool ModoEdicion;
    private bool Guardando;
    private string ErrorMensaje = "";
    private Guid ProductoIdCargado;

    protected override async Task OnParametersSetAsync()
    {
        if (Mostrar && (Producto == null || ProductoIdCargado != ProductoId))
        {
            Producto = null;
            ProductoIdCargado = ProductoId;
            ModoEdicion = false;
            ErrorMensaje = "";
            await AsegurarToken();
            await CargarCategorias();
            await CargarProducto();
        }
    }

    private async Task CargarCategorias()
    {
        using var request = CrearRequest(HttpMethod.Get, "api/v1/Catalogos/categorias");
        using var response = await Http.SendAsync(request);
        if (!response.IsSuccessStatusCode)
        {
            ErrorMensaje = await ObtenerError(response);
            return;
        }
        Categorias = await response.Content.ReadFromJsonAsync<List<CategoriaDto>>() ?? new();
    }

    private async Task CargarProducto()
    {
        using var request = CrearRequest(HttpMethod.Get, $"api/v1/Catalogos/productos/{ProductoId}");
        using var response = await Http.SendAsync(request);
        if (!response.IsSuccessStatusCode)
        {
            ErrorMensaje = await ObtenerError(response);
            return;
        }
        Producto = await response.Content.ReadFromJsonAsync<ProductoDto>();
    }

    private async Task Guardar()
    {
        if (Producto == null) return;
        ErrorMensaje = "";
        if (string.IsNullOrWhiteSpace(Producto.Nombre))
        {
            ErrorMensaje = "El nombre del producto es obligatorio.";
            return;
        }

        Guardando = true;
        try
        {
            using var request = CrearRequest(HttpMethod.Put, $"api/v1/Catalogos/productos/{Producto.Id}");
            request.Content = JsonContent.Create(Producto);
            using var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                ErrorMensaje = await ObtenerError(response);
                return;
            }
            await OnGuardado.InvokeAsync();
            await Cerrar();
        }
        catch (HttpRequestException ex)
        {
            ErrorMensaje = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            Guardando = false;
        }
    }

    private async Task AsegurarToken()
    {
        if (string.IsNullOrWhiteSpace(TokenService.Token))
            TokenService.Token = await JS.InvokeAsync<string>("leerToken");
    }

    private HttpRequestMessage CrearRequest(HttpMethod method, string ruta)
    {
        var request = new HttpRequestMessage(method, ruta);
        if (!string.IsNullOrWhiteSpace(TokenService.Token))
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        return request;
    }

    private static async Task<string> ObtenerError(HttpResponseMessage response)
    {
        var contenido = await response.Content.ReadAsStringAsync();
        return string.IsNullOrWhiteSpace(contenido) ? $"La API respondió con {(int)response.StatusCode}." : contenido.Trim('"');
    }

    private Task Cerrar() => MostrarChanged.InvokeAsync(false);

    private sealed class CategoriaDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
    }

    private sealed class ProductoDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
        public decimal PrecioVentaBaseUSD { get; set; }
        public Guid? CategoriaProductoId { get; set; }
    }
}
