@page "/Pagos/pagos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using StudioERP.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService
<PageTitle>Pagos - StudioERP</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0">Registro de Pagos</h4>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" @onclick="Imprimir"><i class="bi bi-printer"></i> Imprimir</button>
        <button class="btn btn-primary" @onclick="() => MostrarModal = true"><i class="bi bi-plus-lg"></i> Nuevo Pago</button>
    </div>
</div>

@if (MensajeError != "") { <div class="alert alert-danger">@MensajeError</div> }
@if (MensajeExito != "") { <div class="alert alert-success">@MensajeExito</div> }

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Fecha</th>
                    <th>Contrato</th>
                    <th>Cliente</th>
                    <th>Monto</th>
                    <th>Método</th>
                    <th>Estado</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (ListaPagos == null)
                {
                    <tr><td colspan="7" class="text-center py-4 text-muted">Cargando...</td></tr>
                }
                else if (!ListaPagos.Any())
                {
                    <tr><td colspan="7" class="text-center py-4 text-muted">No hay pagos registrados.</td></tr>
                }
                else
                {
                    @foreach (var p in ListaPagos)
                    {
                        <tr>
                            <td class="ps-4">@p.Fecha</td>
                            <td class="fw-bold">@p.Contrato</td>
                            <td>@p.Cliente</td>
                            <td class="fw-bold text-success">
                                @p.Monto.ToString("N2") @p.Moneda
                                @if (p.Moneda == "CUP" && p.MontoUSD.HasValue)
                                {
                                    <div class="small text-muted">≈ $@p.MontoUSD.Value.ToString("N2") USD</div>
                                }
                                else if (p.Moneda == "CUP")
                                {
                                    <div class="small text-warning">Sin tasa histórica</div>
                                }
                            </td>
                            <td>@p.MetodoPago</td>
                            <td>
                                @if (p.EstadoConciliacion == "VERIFICADO") { <span class="badge bg-success">Verificado</span> }
                                else { <span class="badge bg-warning text-dark">Pendiente</span> }
                            </td>
                            <td class="text-end pe-4">
                                @if (p.EstadoConciliacion == "PENDIENTE")
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => Verificar(p.Id)">Verificar</button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (MostrarModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Registrar Pago</h5>
                    <button type="button" class="btn-close" @onclick="() => MostrarModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(ErrorModal)) { <div class="alert alert-danger">@ErrorModal</div> }
                    
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Contrato</label>
                        <select class="form-select" @bind="NuevoPago.ContratoId">
                            <option value="@Guid.Empty">Seleccione...</option>
                            @foreach (var c in ListaContratos)
                            {
                                <option value="@c.Id">@c.NumeroContrato - @c.Cliente</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Monto</label>
                        <input type="number" class="form-control" @bind="NuevoPago.Monto" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Moneda</label>
                        <select class="form-select" @bind="NuevoPago.Moneda">
                            <option value="USD">USD</option>
                            <option value="CUP">CUP</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Método de Pago</label>
                        <select class="form-select" @bind="NuevoPago.MetodoPago">
                            <option value="Efectivo">Efectivo</option>
                            <option value="Transfermovil">Transfermóvil</option>
                            <option value="Enzona">Enzona</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => MostrarModal = false">Cancelar</button>
                    <button class="btn btn-primary" @onclick="GuardarPago">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PagoDto>? ListaPagos;
    private List<ContratoDto> ListaContratos = new();
    private bool MostrarModal = false;
    private string MensajeError = "";
    private string MensajeExito = "";
    private string ErrorModal = "";
    private NuevoPagoDto NuevoPago = new();

    protected override async Task OnInitializedAsync() => await CargarDatos();

    private async Task CargarDatos()
    {
        if (string.IsNullOrEmpty(TokenService.Token))
            TokenService.Token = await JS.InvokeAsync<string>("leerToken");

        var reqPagos = new HttpRequestMessage(HttpMethod.Get, "api/v1/Pagos");
        reqPagos.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        var resPagos = await Http.SendAsync(reqPagos);
        if (resPagos.IsSuccessStatusCode)
            ListaPagos = await resPagos.Content.ReadFromJsonAsync<List<PagoDto>>();

        var reqContratos = new HttpRequestMessage(HttpMethod.Get, "api/v1/Contratos");
        reqContratos.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        var resContratos = await Http.SendAsync(reqContratos);
        if (resContratos.IsSuccessStatusCode)
            ListaContratos = await resContratos.Content.ReadFromJsonAsync<List<ContratoDto>>() ?? new();
    }

    private async Task GuardarPago()
    {
        ErrorModal = "";
        if (NuevoPago.ContratoId == Guid.Empty || NuevoPago.Monto <= 0)
        {
            ErrorModal = "Debe seleccionar un contrato y un monto válido.";
            return;
        }

        var request = new 
        { 
            ContratoId = NuevoPago.ContratoId, 
            Monto = NuevoPago.Monto, 
            Moneda = NuevoPago.Moneda, 
            MetodoPago = NuevoPago.MetodoPago, 
            ReferenciaExterna = "" 
        };

        var req = new HttpRequestMessage(HttpMethod.Post, "api/v1/Pagos");
        req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        req.Content = JsonContent.Create(request);
        var res = await Http.SendAsync(req);

        if (res.IsSuccessStatusCode)
        {
            MensajeExito = "Pago registrado correctamente.";
            MostrarModal = false;
            NuevoPago = new();
            await CargarDatos();
        }
        else
        {
            ErrorModal = "Error al registrar el pago.";
        }
    }

    private async Task Verificar(Guid id)
    {
        var req = new HttpRequestMessage(HttpMethod.Put, $"api/v1/Pagos/{id}/verificar");
        req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        var res = await Http.SendAsync(req);
        if (res.IsSuccessStatusCode)
        {
            MensajeExito = "Pago verificado.";
            await CargarDatos();
        }
    }

    private async Task Imprimir() => await JS.InvokeVoidAsync("window.print");

    public class PagoDto { public Guid Id { get; set; } public string Contrato { get; set; } = ""; public string Cliente { get; set; } = ""; public decimal Monto { get; set; } public decimal? MontoUSD { get; set; } public string Moneda { get; set; } = ""; public string MetodoPago { get; set; } = ""; public string EstadoConciliacion { get; set; } = ""; public string Fecha { get; set; } = ""; }
    public class ContratoDto { public Guid Id { get; set; } public string NumeroContrato { get; set; } = ""; public string Cliente { get; set; } = ""; }
    public class NuevoPagoDto { public Guid ContratoId { get; set; } public decimal Monto { get; set; } public string Moneda { get; set; } = "USD"; public string MetodoPago { get; set; } = "Efectivo"; }
}