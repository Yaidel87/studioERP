@using System.Net.Http.Json
@using StudioERP.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService

@if (Mostrar)
{
    <!-- Fondo oscuro del modal -->
    <div class="modal-backdrop fade show"></div>
    
    <!-- Ventana del modal -->
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Editar Usuario: @UsuarioEditando.Username</h5>
                    <button type="button" class="btn-close" @onclick="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <!-- Mensaje de error -->
                    @if (!string.IsNullOrEmpty(ErrorEdicion))
                    {
                        <div class="alert alert-danger">@ErrorEdicion</div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Nickname (Usuario)</label>
                            <input class="form-control" @bind="UsuarioEditando.Username" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Nombre Completo</label>
                            <input class="form-control" @bind="UsuarioEditando.NombreCompleto" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Email</label>
                            <input type="email" class="form-control" @bind="UsuarioEditando.Email" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Rol del Sistema</label>
                            <!-- El select se deshabilita mientras carga -->
                            <select class="form-select" @bind="UsuarioEditando.RolId" disabled="@CargandoRoles">
                                @if (CargandoRoles)
                                {
                                    <option>Cargando roles...</option>
                                }
                                else
                                {
                                    @foreach (var rol in ListaRoles)
                                    {
                                        <option value="@rol.Id">@rol.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" @bind="UsuarioEditando.Activo" id="chkActivo">
                                <label class="form-check-label" for="chkActivo">Usuario Activo (puede iniciar sesión)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="Guardar" disabled="@Guardando">
                        @if (Guardando) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Guardar Cambios
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Parámetros que recibe del componente padre
    [Parameter] public bool Mostrar { get; set; } = false;
    [Parameter] public EventCallback<bool> MostrarChanged { get; set; }
    [Parameter] public EventCallback OnGuardado { get; set; }
    
    // Objeto con los datos del usuario a editar
    [Parameter] public UsuarioEditDto UsuarioEditando { get; set; } = new();

    // Variables internas del modal
    private List<RolDto> ListaRoles = new();
    private bool Guardando = false;
    private bool CargandoRoles = false;
    private string ErrorEdicion = "";

    // Cada vez que el padre abre el modal, cargamos los roles
    protected override async Task OnParametersSetAsync()
    {
        if (Mostrar && ListaRoles.Count == 0 && !CargandoRoles)
        {
            await CargarRoles();
        }
    }

    // Carga la lista de roles desde la API
    private async Task CargarRoles()
    {
        CargandoRoles = true;
        ErrorEdicion = "";
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var req = new HttpRequestMessage(HttpMethod.Get, "api/v1/Usuarios/roles");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var res = await Http.SendAsync(req);
            
            if (res.IsSuccessStatusCode)
            {
                ListaRoles = await res.Content.ReadFromJsonAsync<List<RolDto>>() ?? new();
            }
            else
            {
                ErrorEdicion = "No se pudieron cargar los roles de la API.";
            }
        }
        catch (Exception ex)
        {
            ErrorEdicion = "Error de conexión: " + ex.Message;
        }
        
        CargandoRoles = false;
        StateHasChanged();
    }

    // Envía los cambios a la API
    private async Task Guardar()
    {
        ErrorEdicion = "";
        Guardando = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var request = new 
            { 
                Username = UsuarioEditando.Username,
                NombreCompleto = UsuarioEditando.NombreCompleto, 
                Email = UsuarioEditando.Email, 
                RolId = UsuarioEditando.RolId,
                Activo = UsuarioEditando.Activo
            };

            var req = new HttpRequestMessage(HttpMethod.Put, $"api/v1/Usuarios/{UsuarioEditando.Id}/admin");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            req.Content = JsonContent.Create(request);

            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
            {
                await OnGuardado.InvokeAsync();
                await Cerrar();
            }
            else
            {
                var errorMsg = await res.Content.ReadAsStringAsync();
                ErrorEdicion = string.IsNullOrEmpty(errorMsg) ? "Error al actualizar el usuario." : errorMsg.Replace("\"", "");
            }
        }
        catch (Exception ex)
        {
            ErrorEdicion = "Error de conexión: " + ex.Message;
        }

        Guardando = false;
        StateHasChanged();
    }

    // Cierra el modal
    private async Task Cerrar()
    {
        await MostrarChanged.InvokeAsync(false);
    }

    // --- CLASES DTO ---
    public class UsuarioEditDto
    {
        public Guid Id { get; set; }
        public string Username { get; set; } = "";
        public string NombreCompleto { get; set; } = "";
        public string Email { get; set; } = "";
        public Guid RolId { get; set; }
        public bool Activo { get; set; }
    }

    public class RolDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
    }
}