@using System.Net.Http.Json
@using StudioERP.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService

@if (Mostrar)
{
    <!-- Fondo oscuro del modal -->
    <div class="modal-backdrop fade show"></div>
    
    <!-- Ventana del modal -->
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Nuevo Usuario</h5>
                    <button type="button" class="btn-close" @onclick="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(ErrorMensaje))
                    {
                        <div class="alert alert-danger">@ErrorMensaje</div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Nickname</label>
                            <input class="form-control" @bind="NuevoUsuario.Username" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Nombre Completo</label>
                            <input class="form-control" @bind="NuevoUsuario.NombreCompleto" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Carnet de Identidad</label>
                            <input class="form-control" @bind="NuevoUsuario.CarnetIdentidad" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Email</label>
                            <input type="email" class="form-control" @bind="NuevoUsuario.Email" required />
                        </div>
                        <div class="col-md-12">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label small fw-bold mb-0">Otros contactos</label>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AgregarContacto">Agregar</button>
                            </div>
                            @foreach (var contacto in NuevoUsuario.Contactos)
                            {
                                <div class="row g-2 mb-2">
                                    <div class="col-4">
                                        <select class="form-select" @bind="contacto.Tipo">
                                            <option value="Telefono">Teléfono</option>
                                            <option value="Email">Email</option>
                                            <option value="Direccion">Dirección</option>
                                        </select>
                                    </div>
                                    <div class="col-7"><input class="form-control" @bind="contacto.Valor" /></div>
                                    <div class="col-1"><button type="button" class="btn btn-outline-danger" @onclick="() => NuevoUsuario.Contactos.Remove(contacto)">×</button></div>
                                </div>
                            }
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Contraseña</label>
                            <input type="password" class="form-control" @bind="NuevoUsuario.Password" minlength="6" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Rol</label>
                            <select class="form-select" @bind="NuevoUsuario.RolId" required>
                                <option value="@Guid.Empty">Seleccione un rol...</option>
                                @foreach (var rol in ListaRoles)
                                {
                                    <option value="@rol.Id">@rol.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" @bind="NuevoUsuario.Activo" id="chkActivo">
                                <label class="form-check-label" for="chkActivo">Usuario Activo (puede iniciar sesión)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="Guardar" disabled="@Guardando">
                        @if (Guardando) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Guardar Usuario
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Mostrar { get; set; } = false;
    [Parameter] public EventCallback<bool> MostrarChanged { get; set; }
    [Parameter] public EventCallback<Guid> OnGuardado { get; set; }

    private List<RolDto> ListaRoles = new();
    private bool Guardando = false;
    private string ErrorMensaje = "";
    
    // Inicializamos el DTO con Activo = true por defecto
    private NuevoUsuarioDto NuevoUsuario = new() { Activo = true };

    protected override async Task OnParametersSetAsync()
    {
        if (Mostrar && ListaRoles.Count == 0)
        {
            await CargarRoles();
        }
    }

    private async Task CargarRoles()
    {
        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var req = new HttpRequestMessage(HttpMethod.Get, "api/v1/Usuarios/roles");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var res = await Http.SendAsync(req);
            
            if (res.IsSuccessStatusCode)
                ListaRoles = await res.Content.ReadFromJsonAsync<List<RolDto>>() ?? new();
        }
        catch { }
    }

    private async Task Guardar()
    {
        ErrorMensaje = "";
        if (string.IsNullOrWhiteSpace(NuevoUsuario.Username) ||
            string.IsNullOrWhiteSpace(NuevoUsuario.NombreCompleto) ||
            string.IsNullOrWhiteSpace(NuevoUsuario.Email) ||
            string.IsNullOrWhiteSpace(NuevoUsuario.Password) ||
            NuevoUsuario.RolId == Guid.Empty)
        {
            ErrorMensaje = "Todos los campos son obligatorios.";
            return;
        }
        if (!new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(NuevoUsuario.Email))
        {
            ErrorMensaje = "Escribe un email válido.";
            return;
        }
        if (NuevoUsuario.Password.Length < 6)
        {
            ErrorMensaje = "La contraseña debe tener al menos 6 caracteres.";
            return;
        }

        Guardando = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var req = new HttpRequestMessage(HttpMethod.Post, "api/v1/Usuarios");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var request = new
            {
                NuevoUsuario.Username,
                NuevoUsuario.NombreCompleto,
                NuevoUsuario.CarnetIdentidad,
                NuevoUsuario.Email,
                NuevoUsuario.Password,
                NuevoUsuario.RolId,
                NuevoUsuario.Activo,
                Contactos = NuevoUsuario.Contactos
                    .Where(contacto => !string.IsNullOrWhiteSpace(contacto.Valor))
                    .Select(contacto => new { contacto.Tipo, Valor = contacto.Valor.Trim() })
                    .ToList()
            };
            req.Content = JsonContent.Create(request);
            
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
            {
                var result = await res.Content.ReadFromJsonAsync<RespuestaUsuario>();
                if (result != null && result.Id != Guid.Empty)
                {
                    await OnGuardado.InvokeAsync(result.Id);
                    await Cerrar();
                }
            }
            else
            {
                var error = await res.Content.ReadAsStringAsync();
                ErrorMensaje = string.IsNullOrEmpty(error) ? "Error al crear usuario." : error.Replace("\"", "");
            }
        }
        catch (Exception ex)
        {
            ErrorMensaje = "Error: " + ex.Message;
        }
        finally
        {
            Guardando = false;
            StateHasChanged();
        }
    }

    private async Task Cerrar()
    {
        NuevoUsuario = new() { Activo = true }; // Limpiamos el formulario
        ErrorMensaje = "";
        await MostrarChanged.InvokeAsync(false);
    }

    private void AgregarContacto() => NuevoUsuario.Contactos.Add(new ContactoDto { Tipo = "Telefono" });

    // --- CLASES DTO ---
    public class RolDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
    }

    public class NuevoUsuarioDto
    {
        public string Username { get; set; } = "";
        public string NombreCompleto { get; set; } = "";
        public string CarnetIdentidad { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public Guid RolId { get; set; }
        public bool Activo { get; set; } = true; // <-- Nuevo campo
        public List<ContactoDto> Contactos { get; set; } = new();
    }

    public class ContactoDto
    {
        public string Tipo { get; set; } = "Telefono";
        public string Valor { get; set; } = "";
    }

    public class RespuestaUsuario
    {
        public Guid Id { get; set; }
        public string Mensaje { get; set; } = "";
    }
}