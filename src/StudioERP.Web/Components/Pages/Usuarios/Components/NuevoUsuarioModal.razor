@using System.Net.Http.Json
@using StudioERP.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService

@if (Mostrar)
{
    <!-- Fondo oscuro del modal -->
    <div class="modal-backdrop fade show"></div>
    
    <!-- Ventana del modal -->
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Nuevo Usuario</h5>
                    <button type="button" class="btn-close" @onclick="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(ErrorMensaje))
                    {
                        <div class="alert alert-danger">@ErrorMensaje</div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Nickname</label>
                            <input class="form-control" @bind="NuevoUsuario.Username" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Nombre Completo</label>
                            <input class="form-control" @bind="NuevoUsuario.NombreCompleto" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Email</label>
                            <input type="email" class="form-control" @bind="NuevoUsuario.Email" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Contraseña</label>
                            <input type="password" class="form-control" @bind="NuevoUsuario.Password" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Rol</label>
                            <select class="form-select" @bind="NuevoUsuario.RolId">
                                <option value="@Guid.Empty">Seleccione un rol...</option>
                                @foreach (var rol in ListaRoles)
                                {
                                    <option value="@rol.Id">@rol.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" @bind="NuevoUsuario.Activo" id="chkActivo">
                                <label class="form-check-label" for="chkActivo">Usuario Activo (puede iniciar sesión)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="Guardar" disabled="@Guardando">
                        @if (Guardando) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Guardar Usuario
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Mostrar { get; set; } = false;
    [Parameter] public EventCallback<bool> MostrarChanged { get; set; }
    [Parameter] public EventCallback<Guid> OnGuardado { get; set; }

    private List<RolDto> ListaRoles = new();
    private bool Guardando = false;
    private string ErrorMensaje = "";
    
    // Inicializamos el DTO con Activo = true por defecto
    private NuevoUsuarioDto NuevoUsuario = new() { Activo = true };

    protected override async Task OnParametersSetAsync()
    {
        if (Mostrar && ListaRoles.Count == 0)
        {
            await CargarRoles();
        }
    }

    private async Task CargarRoles()
    {
        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var req = new HttpRequestMessage(HttpMethod.Get, "api/v1/Usuarios/roles");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var res = await Http.SendAsync(req);
            
            if (res.IsSuccessStatusCode)
                ListaRoles = await res.Content.ReadFromJsonAsync<List<RolDto>>() ?? new();
        }
        catch { }
    }

    private async Task Guardar()
    {
        ErrorMensaje = "";
        if (string.IsNullOrEmpty(NuevoUsuario.Username) || 
            string.IsNullOrEmpty(NuevoUsuario.NombreCompleto) || 
            string.IsNullOrEmpty(NuevoUsuario.Password) || 
            NuevoUsuario.RolId == Guid.Empty)
        {
            ErrorMensaje = "Todos los campos son obligatorios.";
            return;
        }

        Guardando = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var req = new HttpRequestMessage(HttpMethod.Post, "api/v1/Usuarios");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            req.Content = JsonContent.Create(NuevoUsuario);
            
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
            {
                var result = await res.Content.ReadFromJsonAsync<RespuestaUsuario>();
                if (result != null && result.Id != Guid.Empty)
                {
                    await OnGuardado.InvokeAsync(result.Id);
                    await Cerrar();
                }
            }
            else
            {
                var error = await res.Content.ReadAsStringAsync();
                ErrorMensaje = string.IsNullOrEmpty(error) ? "Error al crear usuario." : error.Replace("\"", "");
            }
        }
        catch (Exception ex)
        {
            ErrorMensaje = "Error: " + ex.Message;
        }
        finally
        {
            Guardando = false;
            StateHasChanged();
        }
    }

    private async Task Cerrar()
    {
        NuevoUsuario = new() { Activo = true }; // Limpiamos el formulario
        ErrorMensaje = "";
        await MostrarChanged.InvokeAsync(false);
    }

    // --- CLASES DTO ---
    public class RolDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
    }

    public class NuevoUsuarioDto
    {
        public string Username { get; set; } = "";
        public string NombreCompleto { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public Guid RolId { get; set; }
        public bool Activo { get; set; } = true; // <-- Nuevo campo
    }

    public class RespuestaUsuario
    {
        public Guid Id { get; set; }
        public string Mensaje { get; set; } = "";
    }
}