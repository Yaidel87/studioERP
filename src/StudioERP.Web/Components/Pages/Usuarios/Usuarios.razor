@page "/usuarios"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using StudioERP.Web.Services
@using StudioERP.Web.Components.Pages.Usuarios.Components

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService
<PageTitle>Usuarios - StudioERP</PageTitle>

<!-- CABECERA: Título y Botón para abrir el modal de creación -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0">Gestión de Usuarios</h4>
    <button class="btn btn-primary" @onclick="() => MostrarModalNuevoUsuario = true">
        <i class="bi bi-plus-lg"></i> Nuevo Usuario
    </button>
</div>

<!-- MENSAJES DE ALERTA -->
@if (MensajeError != "") { <div class="alert alert-danger">@MensajeError</div> }
@if (MensajeExito != "") { <div class="alert alert-success">@MensajeExito</div> }

<!-- TABLA DE USUARIOS -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Usuario</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (ListaUsuarios == null)
                {
                    <tr><td colspan="5" class="text-center py-4 text-muted">Cargando...</td></tr>
                }
                else
                {
                    @foreach (var u in ListaUsuarios)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(u.PhotoUrl))
                                    {
                                        <img src="@($"http://localhost:5046{u.PhotoUrl}")" class="rounded-circle me-3" style="width: 40px; height: 40px; object-fit: cover;" alt="Foto" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; font-weight: bold;">
                                            @(u.NombreCompleto.Length > 0 ? u.NombreCompleto[0].ToString() : "?")
                                        </div>
                                    }
                                    <div>
                                        <div class="fw-bold">@u.NombreCompleto</div>
                                        <small class="text-muted">@@@u.Username</small>
                                    </div>
                                </div>
                            </td>
                            <td>@u.Email</td>
                            <td><span class="badge bg-secondary">@u.Rol</span></td>
                            <td>
                                @if (u.Activo) { <span class="badge bg-success">Activo</span> }
                                else { <span class="badge bg-danger">Inactivo</span> }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => AbrirEdicion(u)">
                                        <i class="bi bi-pencil"></i> Editar
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarUsuario(u.Id)">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- COMPONENTES MODALES -->
<NuevoUsuarioModal @bind-Mostrar="MostrarModalNuevoUsuario" OnGuardado="RecargarDespuesDeCrear" />
<EditarUsuarioModal @bind-Mostrar="MostrarModalEdicion" 
                    UsuarioEditando="UsuarioEditando" 
                    OnGuardado="RecargarDespuesDeEditar" />

@code {
    // --- VARIABLES DE ESTADO ---
    private List<UsuarioDto>? ListaUsuarios;
    private List<RolDto> Roles = new();
    private string MensajeError = "";
    private string MensajeExito = "";

    // Variables para los Modales
    private bool MostrarModalNuevoUsuario = false;
    private bool MostrarModalEdicion = false;
    private EditarUsuarioModal.UsuarioEditDto UsuarioEditando = new();

    // --- MÉTODOS DE INICIALIZACIÓN ---
    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        if (string.IsNullOrEmpty(TokenService.Token))
            TokenService.Token = await JS.InvokeAsync<string>("leerToken");

        // Cargar Usuarios
        var reqUsers = new HttpRequestMessage(HttpMethod.Get, "api/v1/Usuarios");
        reqUsers.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        var resUsers = await Http.SendAsync(reqUsers);
        if (resUsers.IsSuccessStatusCode)
            ListaUsuarios = await resUsers.Content.ReadFromJsonAsync<List<UsuarioDto>>();

        // Cargar Roles (para el modal de edición)
        var reqRoles = new HttpRequestMessage(HttpMethod.Get, "api/v1/Usuarios/roles");
        reqRoles.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        var resRoles = await Http.SendAsync(reqRoles);
        if (resRoles.IsSuccessStatusCode)
            Roles = await resRoles.Content.ReadFromJsonAsync<List<RolDto>>() ?? new();
    }

    // --- CALLBACKS DE LOS MODALES ---
    private async Task RecargarDespuesDeCrear(Guid nuevoUsuarioId)
    {
        MensajeExito = "Usuario creado correctamente.";
        await CargarDatos();
    }

    private async Task RecargarDespuesDeEditar()
    {
        MensajeExito = "Usuario actualizado correctamente.";
        await CargarDatos();
    }

    // --- ACCIÓN: Abrir Modal de Edición ---
    private void AbrirEdicion(UsuarioDto u)
    {
        var rol = Roles.FirstOrDefault(r => r.Nombre == u.Rol);
        
        UsuarioEditando = new EditarUsuarioModal.UsuarioEditDto
        {
            Id = u.Id,
            Username = u.Username,
            NombreCompleto = u.NombreCompleto,
            Email = u.Email,
            RolId = rol?.Id ?? Guid.Empty,
            Activo = u.Activo
        };
        MostrarModalEdicion = true;
    }

    // --- ACCIÓN: Eliminar Usuario (Borrado Lógico) ---
    private async Task EliminarUsuario(Guid id)
    {
        bool confirmar = await JS.InvokeAsync<bool>("confirm", "¿Estás seguro de que deseas eliminar este usuario?");
        if (!confirmar) return;

        MensajeError = ""; MensajeExito = "";
        
        if (string.IsNullOrEmpty(TokenService.Token))
            TokenService.Token = await JS.InvokeAsync<string>("leerToken");

        var req = new HttpRequestMessage(HttpMethod.Delete, $"api/v1/Usuarios/{id}");
        req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);

        var res = await Http.SendAsync(req);

        if (res.IsSuccessStatusCode)
        {
            MensajeExito = "Usuario eliminado correctamente.";
            await CargarDatos();
        }
        else
        {
            var error = await res.Content.ReadAsStringAsync();
            MensajeError = string.IsNullOrEmpty(error) ? "Error al eliminar." : error.Replace("\"", "");
        }
    }

    // --- CLASES DTO ---
    public class UsuarioDto
    {
        public Guid Id { get; set; }
        public string Username { get; set; } = "";
        public string NombreCompleto { get; set; } = "";
        public string Email { get; set; } = "";
        public string PhotoUrl { get; set; } = "";
        public bool Activo { get; set; }
        public string Rol { get; set; } = "";
    }

    public class RolDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
    }
}