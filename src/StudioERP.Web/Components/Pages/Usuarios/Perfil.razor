@page "/perfil"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using StudioERP.Web.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService
@inject AuthenticationStateProvider AuthProvider
<PageTitle>Mi Perfil - StudioERP</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0">Mi Perfil</h4>
</div>

<div class="row">
    <!-- Columna Izquierda: Foto -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 text-center p-4">
            @if (!string.IsNullOrEmpty(PerfilData.PhotoUrl))
            {
                <img src="@($"http://localhost:5046{PerfilData.PhotoUrl}")" class="rounded-circle mx-auto mb-3 shadow" style="width: 120px; height: 120px; object-fit: cover;" alt="Foto de perfil" />
            }
            else
            {
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3 shadow" style="width: 120px; height: 120px; font-size: 3rem; font-weight: bold;">
                    @(PerfilData.NombreCompleto.Length > 0 ? PerfilData.NombreCompleto[0].ToString() : "?")
                </div>
            }
            
            <h5 class="fw-bold mb-1">@PerfilData.NombreCompleto</h5>
            <p class="text-muted mb-3">@@@PerfilData.Username</p>
            
            <label class="btn btn-outline-primary w-100 mb-0">
                <i class="bi bi-camera"></i> Cambiar Foto
                <InputFile OnChange="SubirFoto" class="d-none" accept="image/*" />
            </label>
            @if (MensajeFoto != "")
            {
                <div class="alert alert-info mt-3 py-1 small">@MensajeFoto</div>
            }
        </div>
    </div>

    <!-- Columna Derecha: Formulario de Datos -->
    <div class="col-md-8">
        <div class="card shadow-sm border-0 p-4">
            
            <h6 class="fw-bold mb-3 border-bottom pb-2">Información Personal</h6>
            
            @if (!string.IsNullOrEmpty(MensajePerfil))
            {
                <div class="alert @(PerfilExito ? "alert-success" : "alert-danger") py-2">@MensajePerfil</div>
            }

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted">Nombre Completo</label>
                    <input class="form-control" @bind="EditarNombre" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted">Email</label>
                    <input type="email" class="form-control" @bind="EditarEmail" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted">Nickname (No editable)</label>
                    <input class="form-control" value="@PerfilData.Username" disabled style="background-color: #e9ecef;" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted">Rol en el Sistema (No editable)</label>
                    <input class="form-control" value="@PerfilData.Rol" disabled style="background-color: #e9ecef;" />
                </div>
                <div class="col-12 mt-2">
                    <button class="btn btn-primary" @onclick="GuardarPerfil">Guardar Cambios</button>
                </div>
            </div>

            <!-- Sección de Cambio de Contraseña -->
            <h6 class="fw-bold mb-3 border-bottom pb-2 mt-4">Cambiar Contraseña</h6>
            
            @if (!string.IsNullOrEmpty(MensajePassword))
            {
                <div class="alert @(PasswordExito ? "alert-success" : "alert-danger") py-2">@MensajePassword</div>
            }

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted">Contraseña Actual</label>
                    <input type="password" class="form-control" @bind="PasswordActual" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted">Nueva Contraseña</label>
                    <input type="password" class="form-control" @bind="PasswordNueva" />
                </div>
                <div class="col-12 mt-2">
                    <button class="btn btn-outline-primary" @onclick="CambiarPassword">Actualizar Contraseña</button>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private PerfilDto PerfilData = new();
    private string MensajeFoto = "";

    // Variables para editar el perfil
    private string EditarNombre = "";
    private string EditarEmail = "";
    private string MensajePerfil = "";
    private bool PerfilExito = false;

    // Variables para cambio de contraseña
    private string PasswordActual = "";
    private string PasswordNueva = "";
    private string MensajePassword = "";
    private bool PasswordExito = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            // 1. Datos básicos desde el Token
            PerfilData.NombreCompleto = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value ?? "";
            PerfilData.Username = user.Claims.FirstOrDefault(c => c.Type == "nickname")?.Value 
                               ?? user.Claims.FirstOrDefault(c => c.Type == "unique_name")?.Value 
                               ?? "";
            PerfilData.Rol = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "";
        }

        // 2. Traer foto y email actualizado desde la API
        await CargarDatosActuales();
        
        // 3. Inicializar los campos editables
        EditarNombre = PerfilData.NombreCompleto;
        EditarEmail = PerfilData.Email;
    }

    private async Task CargarDatosActuales()
    {
        if (string.IsNullOrEmpty(TokenService.Token))
            TokenService.Token = await JS.InvokeAsync<string>("leerToken");

        var req = new HttpRequestMessage(HttpMethod.Get, "api/v1/Usuarios");
        req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        var res = await Http.SendAsync(req);
        
        if (res.IsSuccessStatusCode)
        {
            var usuarios = await res.Content.ReadFromJsonAsync<List<UsuarioDto>>();
            var yo = usuarios?.FirstOrDefault(u => u.Username == PerfilData.Username);
            if (yo != null)
            {
                PerfilData.PhotoUrl = yo.PhotoUrl;
                PerfilData.Email = yo.Email;
                PerfilData.NombreCompleto = yo.NombreCompleto; // Por si se editó antes
                
                // Actualizamos los campos editables con los datos reales
                EditarNombre = yo.NombreCompleto;
                EditarEmail = yo.Email;
            }
        }
    }

    // --- ACCIÓN: Guardar Perfil ---
    private async Task GuardarPerfil()
    {
        MensajePerfil = "";
        if (string.IsNullOrEmpty(EditarNombre) || string.IsNullOrEmpty(EditarEmail))
        {
            MensajePerfil = "El nombre y el email son obligatorios.";
            PerfilExito = false;
            return;
        }

        await AsegurarToken();

        var usuarios = await ObtenerListaUsuarios();
        var yo = usuarios?.FirstOrDefault(u => u.Username == PerfilData.Username);

        if (yo != null)
        {
            var request = new { NombreCompleto = EditarNombre, Email = EditarEmail };
            
            var req = new HttpRequestMessage(HttpMethod.Put, $"api/v1/Usuarios/{yo.Id}/perfil");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            req.Content = JsonContent.Create(request);
            
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
            {
                MensajePerfil = "¡Perfil actualizado correctamente!";
                PerfilExito = true;
                PerfilData.NombreCompleto = EditarNombre;
                PerfilData.Email = EditarEmail;
            }
            else
            {
                MensajePerfil = "Error al actualizar el perfil.";
                PerfilExito = false;
            }
        }
    }

    // --- ACCIÓN: Subir Foto ---
    private async Task SubirFoto(InputFileChangeEventArgs e)
    {
        MensajeFoto = "Subiendo foto...";
        var file = e.File;
        
        if (file != null)
        {
            await AsegurarToken();
            var usuarios = await ObtenerListaUsuarios();
            var yo = usuarios?.FirstOrDefault(u => u.Username == PerfilData.Username);

            if (yo != null)
            {
                using var content = new MultipartFormDataContent();
                var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
                content.Add(fileContent, "archivo", file.Name);

                var req = new HttpRequestMessage(HttpMethod.Post, $"api/v1/Usuarios/{yo.Id}/foto");
                req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
                req.Content = content;

                var res = await Http.SendAsync(req);
                if (res.IsSuccessStatusCode)
                {
                    MensajeFoto = "¡Foto actualizada!";
                    await CargarDatosActuales();
                }
                else
                {
                    MensajeFoto = "Error al subir la foto.";
                }
            }
        }
    }

    // --- ACCIÓN: Cambiar Contraseña ---
    private async Task CambiarPassword()
    {
        MensajePassword = "";
        if (string.IsNullOrEmpty(PasswordActual) || string.IsNullOrEmpty(PasswordNueva))
        {
            MensajePassword = "Ambos campos son obligatorios.";
            PasswordExito = false;
            return;
        }

        if (PasswordNueva.Length < 6)
        {
            MensajePassword = "La nueva contraseña debe tener al menos 6 caracteres.";
            PasswordExito = false;
            return;
        }

        await AsegurarToken();
        var usuarios = await ObtenerListaUsuarios();
        var yo = usuarios?.FirstOrDefault(u => u.Username == PerfilData.Username);

        if (yo != null)
        {
            var request = new { PasswordActual = PasswordActual, PasswordNueva = PasswordNueva };
            
            var req = new HttpRequestMessage(HttpMethod.Put, "api/v1/Usuarios/password");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            req.Content = JsonContent.Create(request);
            
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
            {
                MensajePassword = "¡Contraseña actualizada correctamente!";
                PasswordExito = true;
                PasswordActual = "";
                PasswordNueva = "";
            }
            else
            {
                var error = await res.Content.ReadAsStringAsync();
                MensajePassword = string.IsNullOrEmpty(error) ? "Error al cambiar la contraseña." : error.Replace("\"", "");
                PasswordExito = false;
            }
        }
    }

    // --- MÉTODOS AUXILIARES ---
    private async Task AsegurarToken()
    {
        if (string.IsNullOrEmpty(TokenService.Token))
            TokenService.Token = await JS.InvokeAsync<string>("leerToken");
    }

    private async Task<List<UsuarioDto>?> ObtenerListaUsuarios()
    {
        var req = new HttpRequestMessage(HttpMethod.Get, "api/v1/Usuarios");
        req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        var res = await Http.SendAsync(req);
        
        if (res.IsSuccessStatusCode)
            return await res.Content.ReadFromJsonAsync<List<UsuarioDto>>();
        
        return null;
    }

    // --- CLASES DTO ---
    public class PerfilDto
    {
        public string NombreCompleto { get; set; } = "";
        public string Username { get; set; } = "";
        public string Email { get; set; } = "";
        public string Rol { get; set; } = "";
        public string PhotoUrl { get; set; } = "";
    }

    public class UsuarioDto
    {
        public Guid Id { get; set; }
        public string Username { get; set; } = "";
        public string NombreCompleto { get; set; } = "";
        public string Email { get; set; } = "";
        public string PhotoUrl { get; set; } = "";
    }
}