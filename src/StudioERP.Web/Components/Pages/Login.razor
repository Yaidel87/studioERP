@page "/login"
@layout EmptyLayout
@rendermode InteractiveServer
@using System.Net.Http.Json
@using StudioERP.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@attribute [AllowAnonymous]

@inject HttpClient Http
@inject NavigationManager Nav
@inject TokenService TokenService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider
<PageTitle>Iniciar Sesión - StudioERP</PageTitle>

<div class="login-background p-3 p-md-5">
    <div class="login-card shadow-lg w-100">
        
        <div class="text-center mb-4">
            <div class="icon-circle mb-3 mx-auto">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-camera" viewBox="0 0 16 16">
                    <path d="M15 12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h1.172a3 3 0 0 0 2.12-.879l.83-.828A1 1 0 0 1 6.827 3h2.344a1 1 0 0 1 .707.293l.828.828A3 3 0 0 0 12.828 5H14a1 1 0 0 1 1 1v6zM2 4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-1.172a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 9.172 2H6.828a2 2 0 0 0-1.414.586l-.828.828A2 2 0 0 1 3.172 4H2z"/>
                    <path d="M8 11a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5zm0 1a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM3 6.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0z"/>
                </svg>
            </div>
            <h2 class="fw-bold text-dark fs-3">StudioERP</h2>
            <p class="text-muted fs-6">Ingresa a tu panel de control</p>
        </div>

        @if (!string.IsNullOrEmpty(MensajeError))
        {
            <div class="alert alert-danger text-center py-2" style="font-size: 0.9rem;">@MensajeError</div>
        }

        <div class="mb-3">
            <label class="form-label fw-semibold text-muted small">Usuario</label>
            <input type="text" class="form-control form-control-lg" style="background-color: #f9fafb; border: 1px solid #d1d5db;" placeholder="Ej. yaidel" @bind="Username" />
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold text-muted small">Contraseña</label>
            <input type="password" class="form-control form-control-lg" style="background-color: #f9fafb; border: 1px solid #d1d5db;" placeholder="••••••••" @bind="Password" />
        </div>

        <button type="button" class="btn w-100" style="background-color: #4f46e5; color: white; padding: 0.75rem; border-radius: 0.5rem; font-weight: 600; font-size: 1.1rem;" @onclick="HacerLogin" disabled="@Cargando">
            @if (Cargando)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Ingresando...</span>
            }
            else
            {
                <span>Iniciar Sesión</span>
            }
        </button>
    </div>
</div>

@code {
    private string Username = "";
    private string Password = "";
    private string MensajeError = "";
    private bool Cargando = false;

    private async Task HacerLogin()
    {
        MensajeError = "";
        Cargando = true;
        StateHasChanged();

        var request = new { Username = Username, Password = Password };
        
        try
        {
            // Le damos 5 segundos de tiempo límite a la petición
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
            
            var response = await Http.PostAsJsonAsync("api/v1/Auth/login", request, cts.Token);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
                if (result != null && !string.IsNullOrEmpty(result.Token))
                {
                    // 1. Guardamos el token
                    TokenService.Token = result.Token;
                    await JS.InvokeVoidAsync("guardarToken", result.Token);
                    
                    // 2. Avisamos al sistema de autenticación
                    if (AuthProvider is CustomAuthStateProvider customAuth)
                    {
                        customAuth.NotifyUserAuthentication(result.Token);
                    }
                    
                    // 3. Navegamos al Dashboard
                    Nav.NavigateTo("/"); 
                    return;
                }
            }
            else
            {
                MensajeError = "Usuario o contraseña incorrectos.";
            }
        }
        catch (TaskCanceledException)
        {
            MensajeError = "La API no responde. ¿Está encendida en el puerto 5046?";
        }
        catch (Exception ex)
        {
            MensajeError = "Error de conexión: " + ex.Message;
        }
        finally
        {
            Cargando = false;
            StateHasChanged();
        }
    }

    public class LoginResponse
    {
        public string Token { get; set; } = "";
    }
}