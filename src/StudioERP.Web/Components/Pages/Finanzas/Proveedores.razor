@page "/finanzas/proveedores"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Net.Http.Json
@using StudioERP.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService

<PageTitle>Proveedores - StudioERP</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0">Proveedores</h4>
    <button class="btn btn-primary" @onclick="AbrirNuevo">
        <i class="bi bi-plus-lg"></i> Nuevo proveedor
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(MensajeError))
{
    <div class="alert alert-danger">@MensajeError</div>
}
@if (!string.IsNullOrWhiteSpace(MensajeExito))
{
    <div class="alert alert-success">@MensajeExito</div>
}

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Proveedor</th>
                    <th>Contactos</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Cargando)
                {
                    <tr><td colspan="3" class="text-center py-4">Cargando proveedores...</td></tr>
                }
                else if (ListaProveedores.Count == 0)
                {
                    <tr><td colspan="3" class="text-center py-4 text-muted">No hay proveedores registrados.</td></tr>
                }
                else
                {
                    @foreach (var proveedor in ListaProveedores)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@proveedor.Nombre</td>
                            <td>@string.Join(", ", proveedor.Contactos.Select(contacto => $"{contacto.Tipo}: {contacto.Valor}"))</td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-outline-primary me-1"
                                        title="Editar"
                                        @onclick="() => AbrirEdicion(proveedor)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger"
                                        title="Eliminar"
                                        @onclick="() => Eliminar(proveedor)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (MostrarFormulario)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">@(ProveedorEditando == null ? "Nuevo proveedor" : "Editar proveedor")</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarFormulario"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(ErrorFormulario))
                    {
                        <div class="alert alert-danger">@ErrorFormulario</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Nombre <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="Nombre" maxlength="200" />
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0">Contactos</label>
                        <button class="btn btn-sm btn-outline-primary" @onclick="AgregarContacto">Agregar contacto</button>
                    </div>
                    @foreach (var contacto in Contactos)
                    {
                        <div class="row g-2 mb-2">
                            <div class="col-4">
                                <select class="form-select" @bind="contacto.Tipo">
                                    <option value="Telefono">Teléfono</option>
                                    <option value="Email">Email</option>
                                    <option value="Direccion">Dirección</option>
                                </select>
                            </div>
                            <div class="col-7">
                                <input class="form-control" @bind="contacto.Valor" maxlength="250" />
                            </div>
                            <div class="col-1">
                                <button class="btn btn-outline-danger" title="Quitar" @onclick="() => Contactos.Remove(contacto)">×</button>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarFormulario">Cancelar</button>
                    <button class="btn btn-primary" disabled="@Guardando" @onclick="Guardar">
                        @(Guardando ? "Guardando..." : "Guardar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<ProveedorDto> ListaProveedores = new();
    private bool Cargando = true;
    private bool Guardando;
    private bool MostrarFormulario;
    private Guid? ProveedorEditando;
    private string Nombre = string.Empty;
    private readonly List<ContactoDto> Contactos = new();
    private string MensajeError = string.Empty;
    private string MensajeExito = string.Empty;
    private string ErrorFormulario = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarProveedores();
    }

    private async Task CargarProveedores()
    {
        Cargando = true;
        MensajeError = string.Empty;
        try
        {
            await AsegurarToken();
            using var request = CrearRequest(HttpMethod.Get, "api/v1/Proveedores");
            using var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                MensajeError = await ObtenerError(response);
                return;
            }

            ListaProveedores.Clear();
            ListaProveedores.AddRange(await response.Content.ReadFromJsonAsync<List<ProveedorDto>>() ?? new());
        }
        catch (HttpRequestException ex)
        {
            MensajeError = $"No se pudo conectar con la API: {ex.Message}";
        }
        finally
        {
            Cargando = false;
        }
    }

    private void AbrirNuevo()
    {
        ProveedorEditando = null;
        Nombre = string.Empty;
        Contactos.Clear();
        Contactos.Add(new ContactoDto { Tipo = "Telefono" });
        ErrorFormulario = string.Empty;
        MostrarFormulario = true;
    }

    private void AbrirEdicion(ProveedorDto proveedor)
    {
        ProveedorEditando = proveedor.Id;
        Nombre = proveedor.Nombre;
        Contactos.Clear();
        Contactos.AddRange(proveedor.Contactos);
        if (Contactos.Count == 0 && !string.IsNullOrWhiteSpace(proveedor.Telefono))
            Contactos.Add(new ContactoDto { Tipo = "Telefono", Valor = proveedor.Telefono });
        ErrorFormulario = string.Empty;
        MostrarFormulario = true;
    }

    private async Task Guardar()
    {
        ErrorFormulario = string.Empty;
        if (string.IsNullOrWhiteSpace(Nombre))
        {
            ErrorFormulario = "El nombre del proveedor es obligatorio.";
            return;
        }

        Guardando = true;
        try
        {
            await AsegurarToken();
            var path = ProveedorEditando.HasValue
                ? $"api/v1/Proveedores/{ProveedorEditando.Value}"
                : "api/v1/Proveedores";
            var method = ProveedorEditando.HasValue ? HttpMethod.Put : HttpMethod.Post;
            using var request = CrearRequest(method, path);
            request.Content = JsonContent.Create(new ProveedorRequest(
                Nombre.Trim(),
                Contactos.FirstOrDefault(contacto => contacto.Tipo == "Telefono")?.Valor ?? string.Empty,
                Contactos.Where(contacto => !string.IsNullOrWhiteSpace(contacto.Valor))
                    .Select(contacto => new ContactoRequest(contacto.Tipo, contacto.Valor.Trim()))
                    .ToList()));
            using var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                ErrorFormulario = await ObtenerError(response);
                return;
            }

            MostrarFormulario = false;
            MensajeExito = ProveedorEditando.HasValue
                ? "Proveedor actualizado."
                : "Proveedor creado.";
            await CargarProveedores();
        }
        catch (HttpRequestException ex)
        {
            ErrorFormulario = $"No se pudo conectar con la API: {ex.Message}";
        }
        finally
        {
            Guardando = false;
        }
    }

    private async Task Eliminar(ProveedorDto proveedor)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Desactivar al proveedor «{proveedor.Nombre}»?"))
            return;

        try
        {
            await AsegurarToken();
            using var request = CrearRequest(HttpMethod.Delete, $"api/v1/Proveedores/{proveedor.Id}");
            using var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                MensajeError = await ObtenerError(response);
                return;
            }

            MensajeExito = "Proveedor eliminado.";
            await CargarProveedores();
        }
        catch (HttpRequestException ex)
        {
            MensajeError = $"No se pudo conectar con la API: {ex.Message}";
        }
    }

    private async Task AsegurarToken()
    {
        if (string.IsNullOrWhiteSpace(TokenService.Token))
            TokenService.Token = await JS.InvokeAsync<string>("leerToken");
    }

    private HttpRequestMessage CrearRequest(HttpMethod method, string path)
    {
        var request = new HttpRequestMessage(method, path);
        if (!string.IsNullOrWhiteSpace(TokenService.Token))
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        return request;
    }

    private static async Task<string> ObtenerError(HttpResponseMessage response)
    {
        var detail = await response.Content.ReadAsStringAsync();
        return string.IsNullOrWhiteSpace(detail)
            ? $"La API respondió con {(int)response.StatusCode} ({response.ReasonPhrase})."
            : detail.Trim('"');
    }

    private void CerrarFormulario() => MostrarFormulario = false;
    private void AgregarContacto() => Contactos.Add(new ContactoDto { Tipo = "Telefono" });

    private sealed class ProveedorDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Telefono { get; set; } = string.Empty;
        public List<ContactoDto> Contactos { get; set; } = new();
    }

    private sealed class ContactoDto
    {
        public string Tipo { get; set; } = "Telefono";
        public string Valor { get; set; } = string.Empty;
    }

    private sealed record ContactoRequest(string Tipo, string Valor);
    private sealed record ProveedorRequest(string Nombre, string Telefono, List<ContactoRequest> Contactos);
}
