@page "/ventas/reportes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using StudioERP.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService
<PageTitle>Reportes - StudioERP</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0">Resumen Financiero</h4>
    <button class="btn btn-outline-secondary" @onclick="Imprimir"><i class="bi bi-printer"></i> Imprimir</button>
</div>

@if (MensajeError != "") { <div class="alert alert-danger">@MensajeError</div> }

@if (Resumen == null)
{
    <p class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span> Cargando reporte...</p>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 bg-primary text-white">
                <h6>Ingresos Verificados</h6>
                <h3>$@Resumen.Ingresos</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 bg-warning text-dark">
                <h6>Comisiones Pendientes</h6>
                <h3>$@Resumen.ComisionesPendientes</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 bg-danger text-white">
                <h6>Gastos</h6>
                <h3>$@Resumen.Gastos</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 bg-success text-white">
                <h6>Utilidad Bruta</h6>
                <h3>$@Resumen.UtilidadBruta</h3>
            </div>
        </div>
    </div>
}

<hr class="my-5" />

<h4 class="fw-bold mb-4">Registro de Gastos</h4>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold">Categoría</label>
                <select class="form-select" @bind="NuevoGasto.Categoria">
                    <option value="Alquiler">Alquiler</option>
                    <option value="Material">Material</option>
                    <option value="Salario">Salario</option>
                    <option value="Otros">Otros</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold">Descripción</label>
                <input class="form-control" @bind="NuevoGasto.Descripcion" placeholder="Ej. Pago de luz de Octubre" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Monto (USD)</label>
                <input type="number" class="form-control" @bind="NuevoGasto.Monto" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Fecha</label>
                <input type="date" class="form-control" @bind="NuevoGasto.Fecha" />
            </div>
            <div class="col-md-1">
                <button class="btn btn-success w-100" @onclick="RegistrarGasto"><i class="bi bi-plus-lg"></i></button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Fecha</th>
                    <th>Categoría</th>
                    <th>Descripción</th>
                    <th class="text-end pe-4">Monto</th>
                </tr>
            </thead>
            <tbody>
                @if (ListaGastos == null)
                {
                    <tr><td colspan="4" class="text-center py-4 text-muted">Cargando...</td></tr>
                }
                else if (!ListaGastos.Any())
                {
                    <tr><td colspan="4" class="text-center py-4 text-muted">No hay gastos registrados.</td></tr>
                }
                else
                {
                    @foreach (var g in ListaGastos)
                    {
                        <tr>
                            <td class="ps-4">@g.Fecha.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-secondary">@g.Categoria</span></td>
                            <td>@g.Descripcion</td>
                            <td class="text-end pe-4 fw-bold text-danger">-$@g.Monto</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private ResumenDto? Resumen;
    private List<GastoDto>? ListaGastos;
    private string MensajeError = "";

    private NuevoGastoDto NuevoGasto = new() { Fecha = DateTime.Today };

    protected override async Task OnInitializedAsync()
    {
        await CargarResumen();
        await CargarGastos();
    }

    private async Task CargarResumen()
    {
        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var req = new HttpRequestMessage(HttpMethod.Get, "api/v1/Pagos/resumen");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
                Resumen = await res.Content.ReadFromJsonAsync<ResumenDto>();
        }
        catch (Exception ex) { MensajeError = "Error: " + ex.Message; }
    }

    private async Task CargarGastos()
    {
        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var req = new HttpRequestMessage(HttpMethod.Get, "api/v1/Gastos");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
                ListaGastos = await res.Content.ReadFromJsonAsync<List<GastoDto>>();
        }
        catch (Exception ex) { MensajeError = "Error: " + ex.Message; }
    }

    private async Task RegistrarGasto()
    {
        MensajeError = "";
        if (string.IsNullOrEmpty(NuevoGasto.Descripcion) || NuevoGasto.Monto <= 0)
        {
            MensajeError = "La descripción y el monto son obligatorios.";
            return;
        }

        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var request = new { Categoria = NuevoGasto.Categoria, Descripcion = NuevoGasto.Descripcion, Monto = NuevoGasto.Monto, Moneda = "USD", Fecha = NuevoGasto.Fecha };
            var req = new HttpRequestMessage(HttpMethod.Post, "api/v1/Gastos");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            req.Content = JsonContent.Create(request);
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
            {
                NuevoGasto = new() { Fecha = DateTime.Today };
                await CargarResumen();
                await CargarGastos();
            }
        }
        catch (Exception ex) { MensajeError = "Error: " + ex.Message; }
    }

    private async Task Imprimir() => await JS.InvokeVoidAsync("window.print");

    public class ResumenDto
    {
        public decimal Ingresos { get; set; }
        public decimal ComisionesPendientes { get; set; }
        public decimal Gastos { get; set; }
        public decimal UtilidadBruta { get; set; }
    }

    public class GastoDto
    {
        public Guid Id { get; set; }
        public string Categoria { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public decimal Monto { get; set; }
        public DateTime Fecha { get; set; }
    }

    public class NuevoGastoDto
    {
        public string Categoria { get; set; } = "Alquiler";
        public string Descripcion { get; set; } = "";
        public decimal Monto { get; set; }
        public DateTime Fecha { get; set; }
    }
}