@page "/finanzas/tipos-cambio"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using StudioERP.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService

<PageTitle>Tasas de cambio - StudioERP</PageTitle>

<h4 class="fw-bold mb-4">Tasas de cambio y saldo CUP</h4>

@if (!string.IsNullOrWhiteSpace(Mensaje))
{
    <div class="alert @(EsError ? "alert-danger" : "alert-success")">@Mensaje</div>
}

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="text-muted">Saldo disponible en CUP</h6>
                <h3 class="fw-bold">@SaldoCUP.ToString("N2") CUP</h3>
                @if (TasaActual is not null)
                {
                    <p class="mb-0 text-muted">Tasa vigente: @TasaActual.CupPorUsd.ToString("N4") CUP por USD (@TasaActual.Fecha.ToString("dd/MM/yyyy"))</p>
                }
                else
                {
                    <p class="mb-0 text-muted">No hay una tasa de cambio registrada.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h5 class="fw-bold">Registrar tasa diaria</h5>
                <div class="row g-3 align-items-end">
                    <div class="col-sm-4">
                        <label class="form-label">Fecha</label>
                        <input type="date" class="form-control" @bind="NuevaTasa.Fecha" />
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label">CUP por USD</label>
                        <input type="number" min="0.0001" step="0.0001" class="form-control" @bind="NuevaTasa.CupPorUsd" />
                    </div>
                    <div class="col-sm-4">
                        <button class="btn btn-primary w-100" @onclick="RegistrarTasa">Guardar tasa</button>
                    </div>
                </div>
                <hr />
                <h5 class="fw-bold">Cambiar CUP a USD</h5>
                <div class="row g-3 align-items-end">
                    <div class="col-sm-8">
                        <label class="form-label">Monto CUP</label>
                        <input type="number" min="0.01" step="0.01" max="@SaldoCUP" class="form-control" @bind="MontoCambio" />
                    </div>
                    <div class="col-sm-4">
                        <button class="btn btn-outline-primary w-100" @onclick="CambiarMoneda">Registrar cambio</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white fw-bold">Historial de tasas registradas</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Fecha</th><th class="text-end">CUP por USD</th></tr>
            </thead>
            <tbody>
                @if (Historial.Count == 0)
                {
                    <tr><td colspan="2" class="text-center text-muted py-3">No hay tasas registradas.</td></tr>
                }
                else
                {
                    @foreach (var item in Historial)
                    {
                        <tr><td>@item.Fecha.ToString("dd/MM/yyyy")</td><td class="text-end">@item.CupPorUsd.ToString("N4")</td></tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm border-0 mt-4">
    <div class="card-header bg-white fw-bold">Historial de conversiones CUP a USD</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Fecha</th><th class="text-end">CUP entregados</th><th class="text-end">Tasa aplicada</th><th class="text-end">USD recibidos</th></tr>
            </thead>
            <tbody>
                @if (Cambios.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-3">No hay conversiones registradas.</td></tr>
                }
                else
                {
                    @foreach (var cambio in Cambios)
                    {
                        <tr>
                            <td>@cambio.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">@cambio.MontoCUP.ToString("N2")</td>
                            <td class="text-end">@cambio.CupPorUsd.ToString("N4")</td>
                            <td class="text-end">@cambio.MontoUSDRecibido.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<TasaDto> Historial = new();
    private List<CambioDto> Cambios = new();
    private TasaDto? TasaActual;
    private decimal SaldoCUP;
    private decimal MontoCambio;
    private string Mensaje = "";
    private bool EsError;
    private NuevaTasaDto NuevaTasa = new() { Fecha = DateOnly.FromDateTime(DateTime.Today), CupPorUsd = 1 };

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        if (string.IsNullOrEmpty(TokenService.Token))
            TokenService.Token = await JS.InvokeAsync<string>("leerToken");

        Historial = await Solicitar<List<TasaDto>>("api/v1/TiposCambio") ?? new();
        Cambios = await Solicitar<List<CambioDto>>("api/v1/TiposCambio/cambios") ?? new();
        TasaActual = await Solicitar<TasaDto>("api/v1/TiposCambio/actual");
        var saldo = await Solicitar<SaldoDto>("api/v1/TiposCambio/saldo-cup");
        SaldoCUP = saldo?.SaldoCUP ?? 0;
    }

    private async Task RegistrarTasa()
    {
        if (NuevaTasa.CupPorUsd <= 0)
        {
            MostrarError("La tasa debe ser mayor que cero.");
            return;
        }

        if (await Enviar("api/v1/TiposCambio", NuevaTasa))
        {
            MostrarExito("Tasa registrada correctamente.");
            await CargarDatos();
        }
    }

    private async Task CambiarMoneda()
    {
        if (MontoCambio <= 0)
        {
            MostrarError("El monto debe ser mayor que cero.");
            return;
        }

        if (await Enviar("api/v1/TiposCambio/cambios", new { MontoCUP = MontoCambio }))
        {
            MostrarExito("Cambio registrado. Se guardó la tasa aplicada y el equivalente USD.");
            MontoCambio = 0;
            await CargarDatos();
        }
    }

    private async Task<T?> Solicitar<T>(string ruta)
    {
        using var request = CrearRequest(HttpMethod.Get, ruta);
        using var response = await Http.SendAsync(request);
        if (response.IsSuccessStatusCode)
            return await response.Content.ReadFromJsonAsync<T>();
        if (response.StatusCode == System.Net.HttpStatusCode.NotFound && ruta.EndsWith("/actual", StringComparison.Ordinal))
            return default;

        var detalle = await response.Content.ReadAsStringAsync();
        MostrarError(string.IsNullOrWhiteSpace(detalle) ? $"No se pudo consultar {ruta}." : detalle);
        return default;
    }

    private async Task<bool> Enviar(string ruta, object contenido)
    {
        using var request = CrearRequest(HttpMethod.Post, ruta);
        request.Content = JsonContent.Create(contenido);
        using var response = await Http.SendAsync(request);
        if (response.IsSuccessStatusCode)
            return true;

        var detalle = await response.Content.ReadAsStringAsync();
        MostrarError(string.IsNullOrWhiteSpace(detalle) ? "No se pudo completar la operación." : detalle);
        return false;
    }

    private HttpRequestMessage CrearRequest(HttpMethod metodo, string ruta)
    {
        var request = new HttpRequestMessage(metodo, ruta);
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        return request;
    }

    private void MostrarError(string mensaje)
    {
        Mensaje = mensaje;
        EsError = true;
    }

    private void MostrarExito(string mensaje)
    {
        Mensaje = mensaje;
        EsError = false;
    }

    private sealed class TasaDto
    {
        public DateOnly Fecha { get; set; }
        public decimal CupPorUsd { get; set; }
    }

    private sealed class SaldoDto
    {
        public decimal SaldoCUP { get; set; }
    }

    private sealed class CambioDto
    {
        public DateTime Fecha { get; set; }
        public decimal MontoCUP { get; set; }
        public decimal CupPorUsd { get; set; }
        public decimal MontoUSDRecibido { get; set; }
    }

    private sealed class NuevaTasaDto
    {
        public DateOnly Fecha { get; set; }
        public decimal CupPorUsd { get; set; }
    }
}
