@page "/finanzas/pagos-personal"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Net.Http.Json
@using StudioERP.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService

<PageTitle>Pagos al personal - StudioERP</PageTitle>

<h4 class="fw-bold mb-4">Pagos al personal indirecto</h4>

@if (!string.IsNullOrWhiteSpace(Mensaje))
{
    <div class="alert @(EsError ? "alert-danger" : "alert-success")">@Mensaje</div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h6 class="fw-bold">Registrar pago manual</h6>
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Personal</label>
                <select class="form-select" @bind="NuevoPago.StaffId">
                    <option value="@Guid.Empty">Seleccionar...</option>
                    @foreach (var persona in Personal)
                    {
                        <option value="@persona.Id">@persona.NombreUsuario</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Monto</label>
                <input type="number" class="form-control" min="0.01" step="0.01" @bind="NuevoPago.Monto" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Moneda</label>
                <select class="form-select" @bind="NuevoPago.Moneda">
                    <option value="USD">USD</option>
                    <option value="CUP">CUP</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Concepto</label>
                <input class="form-control" @bind="NuevoPago.Concepto" maxlength="250" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Fecha</label>
                <input type="date" class="form-control" @bind="NuevoPago.Fecha" />
            </div>
            <div class="col-12 text-end">
                <button class="btn btn-primary" @onclick="Registrar" disabled="@Guardando">Registrar pago</button>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Fecha</th>
                    <th>Personal</th>
                    <th>Concepto</th>
                    <th>Monto</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Pagos.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No hay pagos registrados.</td></tr>
                }
                @foreach (var pago in Pagos)
                {
                    <tr>
                        <td>@pago.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>@pago.Personal</td>
                        <td>@pago.Concepto</td>
                        <td>
                            @pago.Monto.ToString("N2") @pago.Moneda
                            @if (pago.MontoUSD.HasValue)
                            {
                                <div class="small text-muted">≈ $@pago.MontoUSD.Value.ToString("N2") USD</div>
                            }
                            else if (pago.Moneda == "CUP")
                            {
                                <div class="small text-muted">Tasa se fijará al pagar</div>
                            }
                        </td>
                        <td><span class="badge @(pago.Estado == "PAGADO" ? "bg-success" : "bg-warning text-dark")">@pago.Estado</span></td>
                        <td class="text-end">
                            @if (pago.Estado == "PENDIENTE")
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => MarcarPagado(pago.Id)">Marcar pagado</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<PersonalDto> Personal = new();
    private List<PagoDto> Pagos = new();
    private CrearPagoDto NuevoPago = new() { Moneda = "USD", Fecha = DateTime.Today };
    private string Mensaje = "";
    private bool EsError;
    private bool Guardando;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        await AsegurarToken();
        using var personalRequest = CrearRequest(HttpMethod.Get, "api/v1/Personal");
        using var personalResponse = await Http.SendAsync(personalRequest);
        if (!personalResponse.IsSuccessStatusCode)
        {
            Mensaje = await ObtenerError(personalResponse);
            EsError = true;
            return;
        }
        Personal = await personalResponse.Content.ReadFromJsonAsync<List<PersonalDto>>() ?? new();

        using var pagosRequest = CrearRequest(HttpMethod.Get, "api/v1/PagosPersonal");
        using var pagosResponse = await Http.SendAsync(pagosRequest);
        if (!pagosResponse.IsSuccessStatusCode)
        {
            Mensaje = await ObtenerError(pagosResponse);
            EsError = true;
            return;
        }
        Pagos = await pagosResponse.Content.ReadFromJsonAsync<List<PagoDto>>() ?? new();
    }

    private async Task Registrar()
    {
        Mensaje = "";
        EsError = false;
        if (NuevoPago.StaffId == Guid.Empty || NuevoPago.Monto <= 0 || string.IsNullOrWhiteSpace(NuevoPago.Concepto))
        {
            Mensaje = "Selecciona el personal e indica un monto y concepto válidos.";
            EsError = true;
            return;
        }

        Guardando = true;
        try
        {
            using var request = CrearRequest(HttpMethod.Post, "api/v1/PagosPersonal");
            request.Content = JsonContent.Create(NuevoPago);
            using var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                Mensaje = await ObtenerError(response);
                EsError = true;
                return;
            }

            Mensaje = "Pago registrado como pendiente.";
            NuevoPago = new() { Moneda = "USD", Fecha = DateTime.Today };
            await CargarDatos();
        }
        catch (HttpRequestException ex)
        {
            Mensaje = $"Error de conexión: {ex.Message}";
            EsError = true;
        }
        finally
        {
            Guardando = false;
        }
    }

    private async Task MarcarPagado(Guid id)
    {
        using var request = CrearRequest(HttpMethod.Put, $"api/v1/PagosPersonal/{id}/estado");
        request.Content = JsonContent.Create(new { Estado = "PAGADO" });
        using var response = await Http.SendAsync(request);
        if (!response.IsSuccessStatusCode)
        {
            Mensaje = await ObtenerError(response);
            EsError = true;
            return;
        }
        Mensaje = "Pago marcado como pagado.";
        EsError = false;
        await CargarDatos();
    }

    private async Task AsegurarToken()
    {
        if (string.IsNullOrWhiteSpace(TokenService.Token))
            TokenService.Token = await JS.InvokeAsync<string>("leerToken");
    }

    private HttpRequestMessage CrearRequest(HttpMethod method, string url)
    {
        var request = new HttpRequestMessage(method, url);
        if (!string.IsNullOrWhiteSpace(TokenService.Token))
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        return request;
    }

    private static async Task<string> ObtenerError(HttpResponseMessage response)
    {
        var content = await response.Content.ReadAsStringAsync();
        return string.IsNullOrWhiteSpace(content)
            ? $"La API respondió con {(int)response.StatusCode}."
            : content.Trim('"');
    }

    private sealed class PersonalDto
    {
        public Guid Id { get; set; }
        public string NombreUsuario { get; set; } = "";
    }

    private sealed class PagoDto
    {
        public Guid Id { get; set; }
        public string Personal { get; set; } = "";
        public decimal Monto { get; set; }
        public decimal? MontoUSD { get; set; }
        public decimal? TasaCambio { get; set; }
        public string Moneda { get; set; } = "";
        public string Concepto { get; set; } = "";
        public DateTime Fecha { get; set; }
        public string Estado { get; set; } = "";
    }

    private sealed class CrearPagoDto
    {
        public Guid StaffId { get; set; }
        public decimal Monto { get; set; }
        public string Moneda { get; set; } = "USD";
        public string Concepto { get; set; } = "";
        public DateTime Fecha { get; set; } = DateTime.Today;
    }
}
