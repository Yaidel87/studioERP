@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using StudioERP.Web.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService
@inject AuthenticationStateProvider AuthProvider
<PageTitle>Dashboard - StudioERP</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0">Hola, @NombreUsuario 👋</h4>
</div>

<!-- TARJETAS DE RESUMEN -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <a href="/ventas/clientes" class="card border-0 shadow-sm text-decoration-none h-100" style="border-radius: 12px;">
            <div class="card-body p-3 text-center">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 48px; height: 48px;">
                    <i class="bi bi-people fs-4"></i>
                </div>
                <h4 class="fw-bold mb-0">@Resumen?.Clientes</h4>
                <small class="text-muted">Clientes</small>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="/ventas/catalogo" class="card border-0 shadow-sm text-decoration-none h-100" style="border-radius: 12px;">
            <div class="card-body p-3 text-center">
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 48px; height: 48px;">
                    <i class="bi bi-box-seam fs-4"></i>
                </div>
                <h4 class="fw-bold mb-0">@Resumen?.Productos</h4>
                <small class="text-muted">Productos</small>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="/ventas/contratos" class="card border-0 shadow-sm text-decoration-none h-100" style="border-radius: 12px;">
            <div class="card-body p-3 text-center">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 48px; height: 48px;">
                    <i class="bi bi-file-earmark-text fs-4"></i>
                </div>
                <h4 class="fw-bold mb-0">@Resumen?.ContratosPendientes</h4>
                <small class="text-muted">Contratos Pendientes</small>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="/agenda" class="card border-0 shadow-sm text-decoration-none h-100" style="border-radius: 12px;">
            <div class="card-body p-3 text-center">
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 48px; height: 48px;">
                    <i class="bi bi-calendar-event fs-4"></i>
                </div>
                <h4 class="fw-bold mb-0">@Resumen?.SesionesHoy</h4>
                <small class="text-muted">Sesiones Hoy</small>
            </div>
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- PRÓXIMAS SESIONES (LISTA) -->
    <div class="col-lg-5">
        <div class="bg-white border rounded-3 p-4 shadow-sm h-100">
            <div class="d-flex justify-content-between mb-4">
                <h6 class="fw-bold m-0 fs-5">Próximas 10 Sesiones</h6>
                <a href="/agenda" class="text-primary text-decoration-none small fw-semibold">Ver Agenda</a>
            </div>

            @if (Sesiones == null)
            {
                <p class="text-muted"><em>Cargando agenda...</em></p>
            }
            else if (!Sesiones.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x fs-1 text-muted"></i>
                    <p class="text-muted mt-2">No hay sesiones en los próximos 30 días.</p>
                </div>
            }
            else
            {
                @foreach (var s in Sesiones)
                {
                    <div class="d-flex gap-3 py-3 border-bottom">
                        <div class="fw-bold text-primary" style="min-width: 100px;">@s.Fecha</div>
                        <div>
                            <h6 class="mb-1 fw-bold">@s.Cliente</h6>
                            <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@s.Locacion</div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- CALENDARIO -->
    <div class="col-lg-7">
        <div class="bg-white border rounded-3 p-4 shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h6 class="fw-bold m-0 fs-5">Calendario</h6>
                <div class="d-flex gap-3 small">
                    <span><span class="badge bg-primary me-1">&nbsp;</span> Sesiones</span>
                    <span><span class="badge bg-danger me-1">&nbsp;</span> Bloqueos</span>
                </div>
            </div>
            <div id="dashboard-calendar" style="min-height: 400px;"></div>
        </div>
    </div>
</div>

@code {
    private ResumenDto? Resumen;
    private List<SesionDto>? Sesiones;
    private string NombreUsuario = "Usuario";
    private List<EventoDto>? EventosCalendario;
    private List<EventoDto>? BloqueosCalendario;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            NombreUsuario = user.Claims.FirstOrDefault(c => c.Type == "nickname")?.Value 
                         ?? user.Claims.FirstOrDefault(c => c.Type == "unique_name")?.Value 
                         ?? user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value 
                         ?? "Usuario";
        }

        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var reqResumen = new HttpRequestMessage(HttpMethod.Get, "api/v1/Dashboard/resumen");
            reqResumen.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var resResumen = await Http.SendAsync(reqResumen);
            if (resResumen.IsSuccessStatusCode)
                Resumen = await resResumen.Content.ReadFromJsonAsync<ResumenDto>();

            var reqSesiones = new HttpRequestMessage(HttpMethod.Get, "api/v1/Dashboard/proximas-sesiones");
            reqSesiones.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var resSesiones = await Http.SendAsync(reqSesiones);
            if (resSesiones.IsSuccessStatusCode)
                Sesiones = await resSesiones.Content.ReadFromJsonAsync<List<SesionDto>>();

            var reqEventos = new HttpRequestMessage(HttpMethod.Get, "api/v1/Agenda/eventos");
            reqEventos.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var resEventos = await Http.SendAsync(reqEventos);
            if (resEventos.IsSuccessStatusCode)
                EventosCalendario = await resEventos.Content.ReadFromJsonAsync<List<EventoDto>>();

            var reqBloqueos = new HttpRequestMessage(HttpMethod.Get, "api/v1/Agenda/bloqueos");
            reqBloqueos.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var resBloqueos = await Http.SendAsync(reqBloqueos);
            if (resBloqueos.IsSuccessStatusCode)
                BloqueosCalendario = await resBloqueos.Content.ReadFromJsonAsync<List<EventoDto>>();
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("cargarFullCalendar");
            await Task.Delay(300);

            if (EventosCalendario != null)
            {
                var bloqueosAdaptados = (BloqueosCalendario ?? new List<EventoDto>()).Select(b => new
                {
                    id = b.Id,
                    title = b.Title,
                    start = b.Start,
                    end = b.End,
                    color = "#b91c1c",
                    backgroundColor = "#b91c1c",
                    borderColor = "#991b1b",
                    display = "background",
                    allDay = true,
                    extendedProps = new { tipo = "BLOQUEO" }
                }).ToList();

                var sesionesAdaptadas = EventosCalendario.Select(s => new
                {
                    id = s.Id,
                    title = s.Title,
                    start = s.Start,
                    end = s.End,
                    color = s.Start != null && s.Start.EndsWith("T00:00:00") ? "#1f2937" : "#4338ca",
                    backgroundColor = s.Start != null && s.Start.EndsWith("T00:00:00") ? "#1f2937" : "#4338ca",
                    borderColor = s.Start != null && s.Start.EndsWith("T00:00:00") ? "#111827" : "#312e81",
                    textColor = "#ffffff",
                    display = "background",
                    allDay = true,
                    extendedProps = new { tipo = "SESION", locacion = s.Locacion, personal = s.Personal }
                }).ToList();

                await JS.InvokeVoidAsync("inicializarCalendarioDashboard", sesionesAdaptadas, bloqueosAdaptados);
            }
        }
    }

    public class ResumenDto
    {
        public int Clientes { get; set; }
        public int Productos { get; set; }
        public int ContratosPendientes { get; set; }
        public int SesionesHoy { get; set; }
    }

    public class SesionDto
    {
        public Guid Id { get; set; }
        public string Fecha { get; set; } = "";
        public string Cliente { get; set; } = "";
        public string Contrato { get; set; } = "";
        public string Locacion { get; set; } = "";
    }

    public class EventoDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public string Start { get; set; } = "";
        public string End { get; set; } = "";
        public string Locacion { get; set; } = "";
        public List<string> Personal { get; set; } = new();
    }
}