@page "/ventas/contratos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using StudioERP.Web.Services
@using StudioERP.Web.Components.Pages.Ventas.Components

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService
<PageTitle>Contratos - StudioERP</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0">Gestión de Contratos</h4>
    <button class="btn btn-primary" @onclick="() => MostrarModalNuevoContrato = true">
        <i class="bi bi-plus-lg"></i> Nuevo Contrato
    </button>
</div>

@if (MensajeError != "") { <div class="alert alert-danger">@MensajeError</div> }
@if (MensajeExito != "") { <div class="alert alert-success">@MensajeExito</div> }

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Número</th>
                    <th>Cliente</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (ListaContratos == null)
                {
                    <tr><td colspan="6" class="text-center py-4 text-muted">Cargando...</td></tr>
                }
                else if (!ListaContratos.Any())
                {
                    <tr><td colspan="6" class="text-center py-4 text-muted">No hay contratos registrados.</td></tr>
                }
                else
                {
                    @foreach (var c in ListaContratos)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@c.NumeroContrato</td>
                            <td>@c.Cliente</td>
                            <td class="fw-bold text-success">$@c.TotalUSD</td>
                            <td>
                                @if (c.Estado == "Borrador") { <span class="badge bg-warning text-dark">Borrador</span> }
                                else if (c.Estado == "Firmado") { <span class="badge bg-primary">Firmado</span> }
                                else if (c.Estado == "Pagado") { <span class="badge bg-success">Pagado</span> }
                                else { <span class="badge bg-secondary">@c.Estado</span> }
                            </td>
                            <td>@c.FechaCreacion.ToString("dd/MM/yyyy")</td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirEdicion(c.Id)">
                                    <i class="bi bi-pencil"></i> Ver / Editar
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modales -->
<NuevoContratoModal @bind-Mostrar="MostrarModalNuevoContrato" OnGuardado="RecargarDespuesDeCrear" />
<EditarContratoModal @bind-Mostrar="MostrarModalEditarContrato" ContratoId="ContratoEditandoId" OnGuardado="RecargarDespuesDeEditar" />

@code {
    private List<ContratoDto>? ListaContratos;
    private bool MostrarModalNuevoContrato = false;
    private bool MostrarModalEditarContrato = false;
    private Guid? ContratoEditandoId = null;
    private string MensajeError = "";
    private string MensajeExito = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        MensajeError = "";
        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var req = new HttpRequestMessage(HttpMethod.Get, "api/v1/Contratos");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var res = await Http.SendAsync(req);
            
            if (res.IsSuccessStatusCode)
                ListaContratos = await res.Content.ReadFromJsonAsync<List<ContratoDto>>();
            else
                MensajeError = "Error al cargar los contratos.";
        }
        catch (Exception ex)
        {
            MensajeError = "Error de conexión: " + ex.Message;
        }
    }

    private void AbrirEdicion(Guid id)
    {
        ContratoEditandoId = id;
        MostrarModalEditarContrato = true;
    }

    private async Task RecargarDespuesDeCrear()
    {
        MensajeExito = "Contrato creado correctamente.";
        await CargarDatos();
    }

    private async Task RecargarDespuesDeEditar()
    {
        MensajeExito = "Estado del contrato actualizado.";
        await CargarDatos();
    }

    public class ContratoDto
    {
        public Guid Id { get; set; }
        public string NumeroContrato { get; set; } = "";
        public string Cliente { get; set; } = "";
        public decimal TotalUSD { get; set; }
        public string Estado { get; set; } = "";
        public DateTime FechaCreacion { get; set; }
    }
}