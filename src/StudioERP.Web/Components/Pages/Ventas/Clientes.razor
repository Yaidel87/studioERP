@page "/ventas/clientes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using StudioERP.Web.Services
@using StudioERP.Web.Components.Pages.Ventas.Components

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService
<PageTitle>Clientes - StudioERP</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0">Gestión de Clientes</h4>
    <div class="d-flex gap-2">
        <input type="text" class="form-control" placeholder="Buscar por nombre, apellido o teléfono..." @bind="Busqueda" @bind:event="oninput" @onkeyup="Buscar" style="width: 300px;" />
        <button class="btn btn-outline-secondary" @onclick="Imprimir"><i class="bi bi-printer"></i> Imprimir</button>
        <button class="btn btn-primary" @onclick="() => AbrirModalNuevo()"><i class="bi bi-plus-lg"></i> Nuevo Cliente</button>
    </div>
</div>

@if (MensajeError != "") { <div class="alert alert-danger">@MensajeError</div> }
@if (MensajeExito != "") { <div class="alert alert-success">@MensajeExito</div> }

<div class="card shadow-sm border-0" id="tablaImprimir">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Nombre Completo</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Descripción</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (ListaClientes == null)
                {
                    <tr><td colspan="5" class="text-center py-4 text-muted">Cargando...</td></tr>
                }
                else if (!ListaClientes.Any())
                {
                    <tr><td colspan="5" class="text-center py-4 text-muted">No hay clientes.</td></tr>
                }
                else
                {
                    @foreach (var c in ListaClientes)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@c.Nombre @c.Apellidos</td>
                            <td>@c.Telefono</td>
                            <td>@c.Email</td>
                            <td>@c.Descripcion</td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => AbrirModalEditar(c.Id)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarCliente(c.Id)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<ClienteModal @bind-Mostrar="MostrarModal" ClienteIdEdicion="ClienteEditandoId" OnGuardado="RecargarDespuesDeGuardar" />

@code {
    private List<ClienteDto>? ListaClientes;
    private string Busqueda = "";
    private bool MostrarModal = false;
    private Guid? ClienteEditandoId = null;
    private string MensajeError = "";
    private string MensajeExito = "";

    protected override async Task OnInitializedAsync() => await CargarDatos();

    private async Task CargarDatos()
    {
        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var url = "api/v1/Clientes";
            if (!string.IsNullOrEmpty(Busqueda)) url += $"?buscar={Uri.EscapeDataString(Busqueda)}";

            var req = new HttpRequestMessage(HttpMethod.Get, url);
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var res = await Http.SendAsync(req);
            
            if (res.IsSuccessStatusCode)
                ListaClientes = await res.Content.ReadFromJsonAsync<List<ClienteDto>>();
        }
        catch (Exception ex)
        {
            MensajeError = "Error: " + ex.Message;
        }
    }

    private async Task Buscar() => await CargarDatos();

    private void AbrirModalNuevo() { ClienteEditandoId = null; MostrarModal = true; }
    private void AbrirModalEditar(Guid id) { ClienteEditandoId = id; MostrarModal = true; }

    private async Task RecargarDespuesDeGuardar()
    {
        MensajeExito = ClienteEditandoId.HasValue ? "Cliente actualizado." : "Cliente creado.";
        await CargarDatos();
    }

    private async Task EliminarCliente(Guid id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "¿Eliminar cliente?")) return;
        
        var req = new HttpRequestMessage(HttpMethod.Delete, $"api/v1/Clientes/{id}");
        req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        await Http.SendAsync(req);
        await CargarDatos();
    }

    private async Task Imprimir()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    public class ClienteDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Apellidos { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public string Telefono { get; set; } = "";
        public string Email { get; set; } = "";
        public string Direccion { get; set; } = "";
    }
}