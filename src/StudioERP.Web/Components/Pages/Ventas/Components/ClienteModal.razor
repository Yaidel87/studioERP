@using System.Net.Http.Json
@using StudioERP.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService

@if (Mostrar)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">@(EsEdicion ? "Editar Cliente" : "Nuevo Cliente")</h5>
                    <button type="button" class="btn-close" @onclick="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(ErrorMensaje))
                    {
                        <div class="alert alert-danger">@ErrorMensaje</div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Nombre</label>
                            <input class="form-control" @bind="ClienteData.Nombre" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Apellidos</label>
                            <input class="form-control" @bind="ClienteData.Apellidos" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Descripción</label>
                            <textarea class="form-control" @bind="ClienteData.Descripcion" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label small fw-bold mb-0">Contactos</label>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AgregarContacto">Agregar contacto</button>
                            </div>
                            @foreach (var contacto in ClienteData.Contactos)
                            {
                                <div class="row g-2 mb-2">
                                    <div class="col-4">
                                        <select class="form-select" @bind="contacto.Tipo">
                                            <option value="Telefono">Teléfono</option>
                                            <option value="Email">Email</option>
                                            <option value="Direccion">Dirección</option>
                                        </select>
                                    </div>
                                    <div class="col-7">
                                        <input class="form-control" type="@(contacto.Tipo == "Email" ? "email" : "text")" @bind="contacto.Valor" />
                                    </div>
                                    <div class="col-1">
                                        <button type="button" class="btn btn-outline-danger" title="Quitar" @onclick="() => ClienteData.Contactos.Remove(contacto)">×</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="Guardar" disabled="@Guardando">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Mostrar { get; set; } = false;
    [Parameter] public EventCallback<bool> MostrarChanged { get; set; }
    [Parameter] public EventCallback OnGuardado { get; set; }
    [Parameter] public Guid? ClienteIdEdicion { get; set; }

    private ClienteDto ClienteData = new();
    private bool EsEdicion => ClienteIdEdicion.HasValue;
    private bool Guardando = false;
    private string ErrorMensaje = "";

    protected override async Task OnParametersSetAsync()
    {
        if (Mostrar)
        {
            ErrorMensaje = "";
            if (EsEdicion)
            {
                await CargarCliente(ClienteIdEdicion!.Value);
            }
            else
            {
                ClienteData = new();
            }
        }
    }

    private async Task CargarCliente(Guid id)
    {
        if (string.IsNullOrEmpty(TokenService.Token))
            TokenService.Token = await JS.InvokeAsync<string>("leerToken");

        var req = new HttpRequestMessage(HttpMethod.Get, $"api/v1/Clientes");
        req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        var res = await Http.SendAsync(req);
        
        if (res.IsSuccessStatusCode)
        {
            var lista = await res.Content.ReadFromJsonAsync<List<ClienteDto>>();
            var encontrado = lista?.FirstOrDefault(c => c.Id == id);
            if (encontrado != null)
            {
                ClienteData = encontrado;
                if (ClienteData.Contactos.Count == 0)
                {
                    if (!string.IsNullOrWhiteSpace(ClienteData.Telefono))
                        ClienteData.Contactos.Add(new ContactoDto { Tipo = "Telefono", Valor = ClienteData.Telefono });
                    if (!string.IsNullOrWhiteSpace(ClienteData.Email))
                        ClienteData.Contactos.Add(new ContactoDto { Tipo = "Email", Valor = ClienteData.Email });
                    if (!string.IsNullOrWhiteSpace(ClienteData.Direccion))
                        ClienteData.Contactos.Add(new ContactoDto { Tipo = "Direccion", Valor = ClienteData.Direccion });
                }
            }
        }
    }

    private async Task Guardar()
    {
        ErrorMensaje = "";
        if (string.IsNullOrEmpty(ClienteData.Nombre))
        {
            ErrorMensaje = "El nombre es obligatorio.";
            return;
        }

        Guardando = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var request = new 
            { 
                Nombre = ClienteData.Nombre, 
                Apellidos = ClienteData.Apellidos,
                Descripcion = ClienteData.Descripcion,
                Telefono = ClienteData.Contactos.FirstOrDefault(contacto => contacto.Tipo == "Telefono")?.Valor ?? "",
                Email = ClienteData.Contactos.FirstOrDefault(contacto => contacto.Tipo == "Email")?.Valor ?? "",
                Direccion = ClienteData.Contactos.FirstOrDefault(contacto => contacto.Tipo == "Direccion")?.Valor ?? "",
                Contactos = ClienteData.Contactos
                    .Where(contacto => !string.IsNullOrWhiteSpace(contacto.Valor))
                    .Select(contacto => new ContactoRequest(contacto.Tipo, contacto.Valor.Trim()))
                    .ToList()
            };

            HttpResponseMessage res;
            if (EsEdicion)
            {
                var req = new HttpRequestMessage(HttpMethod.Put, $"api/v1/Clientes/{ClienteIdEdicion}");
                req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
                req.Content = JsonContent.Create(request);
                res = await Http.SendAsync(req);
            }
            else
            {
                var req = new HttpRequestMessage(HttpMethod.Post, "api/v1/Clientes");
                req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
                req.Content = JsonContent.Create(request);
                res = await Http.SendAsync(req);
            }

            if (res.IsSuccessStatusCode)
            {
                await OnGuardado.InvokeAsync();
                await Cerrar();
            }
            else
            {
                var error = await res.Content.ReadAsStringAsync();
                ErrorMensaje = string.IsNullOrEmpty(error) ? "Error al guardar." : error.Replace("\"", "");
            }
        }
        catch (Exception ex)
        {
            ErrorMensaje = "Error: " + ex.Message;
        }
        finally
        {
            Guardando = false;
            StateHasChanged();
        }
    }

    private async Task Cerrar()
    {
        ClienteData = new();
        await MostrarChanged.InvokeAsync(false);
    }

    private void AgregarContacto() => ClienteData.Contactos.Add(new ContactoDto { Tipo = "Telefono" });

    public class ClienteDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Apellidos { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public string Telefono { get; set; } = "";
        public string Email { get; set; } = "";
        public string Direccion { get; set; } = "";
        public List<ContactoDto> Contactos { get; set; } = new();
    }

    public class ContactoDto
    {
        public string Tipo { get; set; } = "Telefono";
        public string Valor { get; set; } = "";
    }

    private sealed record ContactoRequest(string Tipo, string Valor);
}