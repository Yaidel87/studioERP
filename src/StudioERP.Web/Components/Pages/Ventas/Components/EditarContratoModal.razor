@using System.Net.Http.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using StudioERP.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService
@inject AuthenticationStateProvider AuthProvider

@if (Mostrar)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Contrato @Contrato?.NumeroContrato</h5>
                    <button type="button" class="btn-close" @onclick="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(Mensaje))
                    {
                        <div class="alert @(EsError ? "alert-danger" : "alert-success")">@Mensaje</div>
                    }
                    @if (Contrato == null)
                    {
                        <p class="text-center"><span class="spinner-border spinner-border-sm me-2"></span>Cargando contrato...</p>
                    }
                    else
                    {
                        <div class="row g-3 mb-4">
                            <div class="col-md-6"><small class="text-muted d-block">Cliente</small><strong>@Contrato.Cliente</strong></div>
                            <div class="col-md-3"><small class="text-muted d-block">Fecha</small><strong>@Contrato.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</strong></div>
                            <div class="col-md-3"><small class="text-muted d-block">Total</small><strong>@Contrato.TotalUSD.ToString("N2") USD</strong></div>
                        </div>

                        <h6 class="fw-bold">Servicios y productos</h6>
                        <div class="table-responsive mb-4">
                            <table class="table table-sm">
                                <thead><tr><th>Concepto</th><th>Cantidad</th><th>Precio</th><th>Subtotal</th></tr></thead>
                                <tbody>
                                    @foreach (var item in Contrato.Items)
                                    {
                                        <tr>
                                            <td>@item.Nombre @if (!string.IsNullOrWhiteSpace(item.Promocion)) { <small class="text-muted">(@item.Promocion)</small> }</td>
                                            <td>@item.Cantidad</td>
                                            <td>@item.PrecioVentaUSD.ToString("N2") USD</td>
                                            <td>@item.SubtotalUSD.ToString("N2") USD</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (Contrato.Sesiones.Count > 0)
                        {
                            <h6 class="fw-bold">Sesiones</h6>
                            <ul class="list-group mb-4">
                                @foreach (var sesion in Contrato.Sesiones)
                                {
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>@sesion.Locacion</span>
                                        <span>@sesion.FechaInicio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    </li>
                                }
                            </ul>
                        }

                        <div class="row align-items-end g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Estado</label>
                                <select class="form-select" @bind="NuevoEstado" disabled="@(!PuedeCambiarEstado)">
                                    <option value="Borrador">Borrador</option>
                                    <option value="Firmado">Firmado</option>
                                    <option value="Pagado">Pagado</option>
                                    @if (EsAdmin)
                                    {
                                        <option value="Cancelado">Cancelado</option>
                                    }
                                </select>
                            </div>
                            @if (PuedeCambiarEstado && NuevoEstado != Contrato.Estado)
                            {
                                <div class="col-md-6">
                                    <button class="btn btn-primary" @onclick="GuardarEstado" disabled="@Guardando">
                                        @(Guardando ? "Guardando..." : "Actualizar estado")
                                    </button>
                                </div>
                            }
                            @if (!PuedeCambiarEstado)
                            {
                                <div class="col-md-6 text-muted small">Tu rol permite consultar el contrato, pero no cambiar su estado.</div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Cerrar">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Mostrar { get; set; }
    [Parameter] public EventCallback<bool> MostrarChanged { get; set; }
    [Parameter] public EventCallback OnGuardado { get; set; }
    [Parameter] public Guid? ContratoId { get; set; }

    private ContratoDto? Contrato;
    private string NuevoEstado = "";
    private string Mensaje = "";
    private bool EsError;
    private bool Guardando;
    private bool EsAdmin;
    private bool PuedeCambiarEstado;
    private Guid? IdCargado;

    protected override async Task OnParametersSetAsync()
    {
        if (!Mostrar || !ContratoId.HasValue || IdCargado == ContratoId) return;

        Contrato = null;
        IdCargado = ContratoId;
        Mensaje = "";
        var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
        EsAdmin = user.IsInRole("Admin");
        PuedeCambiarEstado = EsAdmin || user.IsInRole("Fotógrafo");
        await AsegurarToken();

        using var request = CrearRequest(HttpMethod.Get, $"api/v1/Contratos/{ContratoId}");
        using var response = await Http.SendAsync(request);
        if (!response.IsSuccessStatusCode)
        {
            Mensaje = await ObtenerError(response);
            EsError = true;
            return;
        }

        Contrato = await response.Content.ReadFromJsonAsync<ContratoDto>();
        NuevoEstado = Contrato?.Estado ?? "";
    }

    private async Task GuardarEstado()
    {
        if (Contrato == null || !PuedeCambiarEstado) return;
        Guardando = true;
        Mensaje = "";
        try
        {
            using var request = CrearRequest(HttpMethod.Put, $"api/v1/Contratos/{Contrato.Id}/estado");
            request.Content = JsonContent.Create(new { NuevoEstado });
            using var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                Mensaje = await ObtenerError(response);
                EsError = true;
                return;
            }

            Contrato.Estado = NuevoEstado;
            Mensaje = "Estado del contrato actualizado.";
            EsError = false;
            await OnGuardado.InvokeAsync();
        }
        catch (HttpRequestException ex)
        {
            Mensaje = $"Error de conexión: {ex.Message}";
            EsError = true;
        }
        finally
        {
            Guardando = false;
        }
    }

    private async Task AsegurarToken()
    {
        if (string.IsNullOrWhiteSpace(TokenService.Token))
            TokenService.Token = await JS.InvokeAsync<string>("leerToken");
    }

    private HttpRequestMessage CrearRequest(HttpMethod method, string ruta)
    {
        var request = new HttpRequestMessage(method, ruta);
        if (!string.IsNullOrWhiteSpace(TokenService.Token))
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
        return request;
    }

    private static async Task<string> ObtenerError(HttpResponseMessage response)
    {
        var contenido = await response.Content.ReadAsStringAsync();
        return string.IsNullOrWhiteSpace(contenido) ? $"La API respondió con {(int)response.StatusCode}." : contenido.Trim('"');
    }

    private async Task Cerrar()
    {
        IdCargado = null;
        Contrato = null;
        await MostrarChanged.InvokeAsync(false);
    }

    private sealed class ContratoDto
    {
        public Guid Id { get; set; }
        public string NumeroContrato { get; set; } = "";
        public string Estado { get; set; } = "";
        public decimal TotalUSD { get; set; }
        public DateTime FechaCreacion { get; set; }
        public string Cliente { get; set; } = "";
        public List<ItemDto> Items { get; set; } = new();
        public List<SesionDto> Sesiones { get; set; } = new();
    }

    private sealed class ItemDto
    {
        public string Nombre { get; set; } = "";
        public int Cantidad { get; set; }
        public decimal PrecioVentaUSD { get; set; }
        public decimal SubtotalUSD { get; set; }
        public string? Promocion { get; set; }
    }

    private sealed class SesionDto
    {
        public DateTime FechaInicio { get; set; }
        public string Locacion { get; set; } = "";
    }
}
