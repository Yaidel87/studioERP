@using System.Net.Http.Json
@using StudioERP.Web.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject TokenService TokenService

@if (Mostrar)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Nuevo Contrato</h5>
                    <button type="button" class="btn-close" @onclick="Cerrar"></button>
                </div>
                
                <div class="modal-body" style="overflow: visible;">
                    
                    @if (!string.IsNullOrEmpty(ErrorMensaje))
                    {
                        <div class="alert alert-danger">@ErrorMensaje</div>
                    }

                    <!-- DATOS GENERALES DEL CONTRATO -->
                    <div class="row g-3 mb-4">
                        
                        <!-- CLIENTE CON DROPDOWN PERSONALIZADO -->
                        <div class="col-md-4" style="position: relative;">
                            <label class="form-label small fw-bold">Cliente (Nombre o Teléfono)</label>
                            
                            <input class="form-control" 
                                   placeholder="Escriba para buscar..." 
                                   value="@BusquedaCliente"
                                   @oninput="ActualizarBusqueda"
                                   @onfocus="AbrirSugerencias" 
                                   @onblur="CerrarSugerenciasConRetraso" />
                            
                            @if (MostrarSugerencias && ListaClientesFiltrados.Any())
                            {
                                <div class="dropdown-menu show w-100 shadow" 
                                     style="display: block; position: absolute; top: 100%; left: 0; right: 0; z-index: 99999; max-height: 200px; overflow-y: auto;">
                                    @foreach (var c in ListaClientesFiltrados)
                                    {
                                        <button type="button" class="dropdown-item" @onmousedown="() => SeleccionarCliente(c)">
                                            <strong>@c.NombreCompleto</strong> <small class="text-muted">(@c.Telefono)</small>
                                        </button>
                                    }
                                </div>
                            }

                            @if (ClienteSeleccionado != null)
                            {
                                <small class="text-success fw-bold"><i class="bi bi-check-circle"></i> @ClienteSeleccionado.NombreCompleto</small>
                            }
                        </div>
                        
                        <!-- FECHA Y HORA -->
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Fecha y Hora</label>
                            <input type="datetime-local" class="form-control" @bind="FechaSesion" />
                        </div>
                        
                        <!-- LOCACIÓN -->
                        <div class="col-md-2">
                            <label class="form-label small fw-bold">Locación</label>
                            <input class="form-control" @bind="Locacion" placeholder="Ej. Estudio" />
                        </div>

                        <!-- ESTADO INICIAL -->
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Estado del Contrato</label>
                            <select class="form-select" @bind="EstadoInicial">
                                <option value="Borrador">Borrador</option>
                                <option value="Firmado">Firmado</option>
                                <option value="Pagado">Pagado</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Personal asignado (opcional)</label>
                            <select class="form-select" @bind="PersonalSeleccionadoId">
                                <option value="">Sin asignar</option>
                                @foreach (var persona in ListaPersonal)
                                {
                                    <option value="@persona.Id">@persona.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- AGREGAR ÍTEMS -->
                    <h6 class="fw-bold mb-3 border-bottom pb-2">Agregar Ítems al Contrato</h6>
                    
                    <div class="row g-2 mb-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label small fw-bold">Producto / Paquete</label>
                            <select class="form-select" @bind="ItemSeleccionadoId" @bind:after="OnProductoSeleccionado">
                                <option value="@Guid.Empty">Seleccione...</option>
                                @foreach (var p in ListaProductos)
                                {
                                    <option value="@p.Id">@(p.PaqueteId.HasValue ? "Paquete: " : "")@p.Nombre - $@p.PrecioVentaBaseUSD</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold">Cantidad</label>
                            <input type="number" class="form-control" @bind="CantidadItem" min="1" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold">Precio (USD)</label>
                            <input type="number" class="form-control" @bind="PrecioItem" />
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-outline-primary w-100" @onclick="AgregarItem">Agregar</button>
                        </div>
                    </div>

                    <!-- TABLA DE ÍTEMS AGREGADOS -->
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th>Cant.</th>
                                <th>Precio</th>
                                <th>Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!ItemsAgregados.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted">No hay ítems agregados.</td></tr>
                            }
                            else
                            {
                                @foreach (var item in ItemsAgregados)
                                {
                                    <tr>
                                        <td>@item.Nombre</td>
                                        <td>@item.Cantidad</td>
                                        <td>$@item.Precio</td>
                                        <td>$@(item.Cantidad * item.Precio)</td>
                                        <td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => QuitarItem(item)">X</button></td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold"><td colspan="3" class="text-end">Total:</td><td colspan="2">$@TotalContrato</td></tr>
                        </tfoot>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="Guardar" disabled="@Guardando">Crear Contrato</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Mostrar { get; set; } = false;
    [Parameter] public EventCallback<bool> MostrarChanged { get; set; }
    [Parameter] public EventCallback OnGuardado { get; set; }

    private List<ClienteDto> ListaClientes = new();
    private List<ProductoDto> ListaProductos = new();
    private List<PersonalDto> ListaPersonal = new();
    private List<ItemAgregadoDto> ItemsAgregados = new();
    
    private string BusquedaCliente = "";
    private ClienteDto? ClienteSeleccionado = null;
    private bool MostrarSugerencias = false;

    private IEnumerable<ClienteDto> ListaClientesFiltrados
    {
        get
        {
            var busqueda = BusquedaCliente?.Trim().ToLower() ?? "";

            if (string.IsNullOrEmpty(busqueda))
                return ListaClientes.Take(5);

            return ListaClientes.Where(c => 
                c.NombreCompleto.ToLower().Contains(busqueda) || 
                c.Telefono.Contains(busqueda)).Take(10);
        }
    }

    private DateTime? FechaSesion = DateTime.Today.AddHours(9);
    private string Locacion = "Estudio";
    private string EstadoInicial = "Borrador";
    private Guid? PersonalSeleccionadoId;
    
    private Guid ItemSeleccionadoId;
    private int CantidadItem = 1;
    private decimal PrecioItem;

    private bool Guardando = false;
    private string ErrorMensaje = "";

    private decimal TotalContrato => ItemsAgregados.Sum(i => i.Cantidad * i.Precio);

    protected override async Task OnParametersSetAsync()
    {
        if (Mostrar)
        {
            await CargarDatos();
            FechaSesion = DateTime.Today.AddHours(9);
            Locacion = "Estudio";
            EstadoInicial = "Borrador";
            PersonalSeleccionadoId = null;
            ItemsAgregados.Clear();
            ClienteSeleccionado = null;
            BusquedaCliente = "";
            ErrorMensaje = "";
        }
    }

    private async Task CargarDatos()
    {
        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var reqClientes = new HttpRequestMessage(HttpMethod.Get, "api/v1/Clientes");
            reqClientes.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var resClientes = await Http.SendAsync(reqClientes);
            if (resClientes.IsSuccessStatusCode)
                ListaClientes = await resClientes.Content.ReadFromJsonAsync<List<ClienteDto>>() ?? new();

            var reqProductos = new HttpRequestMessage(HttpMethod.Get, "api/v1/Catalogos/productos");
            reqProductos.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var resProductos = await Http.SendAsync(reqProductos);
            if (resProductos.IsSuccessStatusCode)
            {
                var productos = await resProductos.Content.ReadFromJsonAsync<List<ProductoDto>>() ?? new();
                ListaProductos = new();
                foreach (var producto in productos)
                {
                    if (producto.FichasCosto.Count == 0)
                    {
                        producto.ProductoId = producto.Id;
                        ListaProductos.Add(producto);
                        continue;
                    }

                    ListaProductos.AddRange(producto.FichasCosto.Select(ficha => new ProductoDto
                    {
                        Id = ficha.Id,
                        ProductoId = producto.Id,
                        FichaCostoProductoId = ficha.Id,
                        Nombre = $"{producto.Nombre} - {ficha.Variante} ({ficha.Contexto})",
                        PrecioVentaBaseUSD = ficha.PrecioVentaUSD
                    }));
                }
            }
            else
                ErrorMensaje = "No se pudieron cargar los productos.";

            var reqPaquetes = new HttpRequestMessage(HttpMethod.Get, "api/v1/Catalogos/paquetes");
            reqPaquetes.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var resPaquetes = await Http.SendAsync(reqPaquetes);
            if (resPaquetes.IsSuccessStatusCode)
            {
                var paquetes = await resPaquetes.Content.ReadFromJsonAsync<List<PaqueteDto>>() ?? new();
                ListaProductos.AddRange(paquetes.Select(paquete => new ProductoDto
                {
                    Id = paquete.Id,
                    PaqueteId = paquete.Id,
                    ProductoId = null,
                    Nombre = paquete.Nombre,
                    PrecioVentaBaseUSD = paquete.PrecioVentaFinalUSD
                }));
            }
            else
                ErrorMensaje = "No se pudieron cargar los paquetes.";

            var reqPersonal = new HttpRequestMessage(HttpMethod.Get, "api/v1/Agenda/personal-disponible");
            reqPersonal.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            var resPersonal = await Http.SendAsync(reqPersonal);
            if (resPersonal.IsSuccessStatusCode)
                ListaPersonal = await resPersonal.Content.ReadFromJsonAsync<List<PersonalDto>>() ?? new();
            else
                ErrorMensaje = "No se pudo cargar el personal disponible para asignar.";
        }
        catch (Exception ex)
        {
            ErrorMensaje = $"Error al cargar los datos del contrato: {ex.Message}";
        }
    }

    private void ActualizarBusqueda(ChangeEventArgs e)
    {
        BusquedaCliente = e.Value?.ToString() ?? "";
        MostrarSugerencias = true;
        StateHasChanged(); 
    }

    private void AbrirSugerencias()
    {
        MostrarSugerencias = true;
    }

    private void SeleccionarCliente(ClienteDto cliente)
    {
        ClienteSeleccionado = cliente;
        BusquedaCliente = cliente.NombreCompleto;
        MostrarSugerencias = false;
    }

    private void CerrarSugerenciasConRetraso()
    {
        Task.Delay(200).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                MostrarSugerencias = false;
                StateHasChanged();
            });
        });
    }

    private void OnProductoSeleccionado()
    {
        var prod = ListaProductos.FirstOrDefault(p => p.Id == ItemSeleccionadoId);
        if (prod != null) PrecioItem = prod.PrecioVentaBaseUSD;
    }

    private void AgregarItem()
    {
        if (ItemSeleccionadoId == Guid.Empty || CantidadItem <= 0) return;

        var producto = ListaProductos.FirstOrDefault(p => p.Id == ItemSeleccionadoId);
        if (producto == null) return;

        ItemsAgregados.Add(new ItemAgregadoDto 
        { 
            Id = producto.Id, 
            ProductoId = producto.PaqueteId.HasValue ? null : producto.ProductoId ?? producto.Id,
            FichaCostoProductoId = producto.FichaCostoProductoId,
            PaqueteId = producto.PaqueteId,
            Nombre = producto.Nombre, 
            Precio = PrecioItem,
            Cantidad = CantidadItem 
        });

        ItemSeleccionadoId = Guid.Empty;
        CantidadItem = 1;
        PrecioItem = 0;
    }

    private void QuitarItem(ItemAgregadoDto item) => ItemsAgregados.Remove(item);

    private async Task Guardar()
    {
        ErrorMensaje = "";
        if (ClienteSeleccionado == null || !ItemsAgregados.Any())
        {
            ErrorMensaje = "Debe seleccionar un cliente y al menos un ítem.";
            return;
        }

        Guardando = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(TokenService.Token))
                TokenService.Token = await JS.InvokeAsync<string>("leerToken");

            var itemsRequest = ItemsAgregados.Select(i => new {
                ProductoId = i.ProductoId,
                PaqueteId = i.PaqueteId,
                FichaCostoProductoId = i.FichaCostoProductoId,
                Cantidad = i.Cantidad,
                PrecioVentaUSD = i.Precio
            }).ToList();

            var request = new
            {
                ClienteId = ClienteSeleccionado.Id,
                FechaSesion = FechaSesion,
                Locacion = Locacion,
                Estado = EstadoInicial, 
                Items = itemsRequest,
                PersonalId = PersonalSeleccionadoId
            };

            var req = new HttpRequestMessage(HttpMethod.Post, "api/v1/Contratos");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenService.Token);
            req.Content = JsonContent.Create(request);
            
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
            {
                await OnGuardado.InvokeAsync();
                await Cerrar();
            }
            else
            {
                var error = await res.Content.ReadAsStringAsync();
                ErrorMensaje = string.IsNullOrEmpty(error) ? "Error al crear el contrato." : error.Replace("\"", "");
            }
        }
        catch (Exception ex) { ErrorMensaje = "Error: " + ex.Message; }
        finally { Guardando = false; StateHasChanged(); }
    }

    private async Task Cerrar()
    {
        ClienteSeleccionado = null;
        BusquedaCliente = "";
        FechaSesion = null;
        ItemsAgregados.Clear();
        ErrorMensaje = "";
        await MostrarChanged.InvokeAsync(false);
    }

    public class ClienteDto 
    { 
        public Guid Id { get; set; } 
        public string Nombre { get; set; } = ""; 
        public string Apellidos { get; set; } = ""; 
        public string Telefono { get; set; } = ""; 
        public string NombreCompleto => $"{Nombre} {Apellidos}".Trim();
    }
    
    public class ProductoDto
    {
        public Guid Id { get; set; }
        public Guid? ProductoId { get; set; }
        public Guid? PaqueteId { get; set; }
        public Guid? FichaCostoProductoId { get; set; }
        public string Nombre { get; set; } = "";
        public decimal PrecioVentaBaseUSD { get; set; }
        public List<FichaCostoDto> FichasCosto { get; set; } = new();
    }
    public class FichaCostoDto
    {
        public Guid Id { get; set; }
        public string Variante { get; set; } = "";
        public string Contexto { get; set; } = "";
        public decimal PrecioVentaUSD { get; set; }
    }
    public class PaqueteDto { public Guid Id { get; set; } public string Nombre { get; set; } = ""; public decimal PrecioVentaFinalUSD { get; set; } }
    public class PersonalDto { public Guid Id { get; set; } public string Nombre { get; set; } = ""; }
    public class ItemAgregadoDto
    {
        public Guid Id { get; set; }
        public Guid? ProductoId { get; set; }
        public Guid? PaqueteId { get; set; }
        public Guid? FichaCostoProductoId { get; set; }
        public string Nombre { get; set; } = "";
        public int Cantidad { get; set; }
        public decimal Precio { get; set; }
    }
}